---
import Layout from '../layouts/Layout.astro';
import CarCard from '../components/CarCard.astro';
import GlobalViewSwitcher from '../components/GlobalViewSwitcher.astro';
import vehiclesData from '../../../shared/data/vehicles.json';

const modules = [
  { label: 'All modules', value: 'All Modules' },
  { label: 'Arcade', value: 'classic' },
  { label: 'Karting', value: 'Karting & Micro-Racers' },
  { label: 'Rallycross', value: 'Rallycross' },
  { label: 'Autocross', value: 'Autocross' },
  { label: 'All terrain', value: 'Extreme Off-Road & Arenas' },
  { label: 'Gran Turismo', value: 'Gran Turismo & Endurance' },
  { label: 'Stock cars', value: 'NASCAR Stock Car Racing' },
];
---

<Layout title="Garage Showroom & Vehicle Catalog" description={`Explore 30 progression categories across 6 motorsport modules with full specifications and telemetry radar.`}>
  <div class="py-6 border-b border-racing-border">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-extrabold text-white tracking-tight">Interactive Garage Showroom</h1>
        <p class="text-sm text-racing-muted font-mono mt-1">
          {vehiclesData.length} authentic motorsport models across 30 progression classes with Balance of Performance (BoP) calibration.
        </p>
      </div>

      <!-- Controls: Global View Switcher & Quick Search Input -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <GlobalViewSwitcher />

        <div class="w-full sm:w-64">
          <input
            type="text"
            id="car-search"
            placeholder="Search by car name, brand, class..."
            class="w-full px-4 py-2 bg-racing-surface border border-racing-border rounded-lg text-xs font-mono text-white placeholder-racing-muted focus:outline-none focus:border-racing-blue"
          />
        </div>
      </div>
    </div>

    <!-- Filter Buttons -->
    <div class="flex flex-wrap gap-2 mt-6">
      {modules.map((m, idx) => (
        <button
          type="button"
          class={`filter-btn px-3 py-1.5 rounded-lg text-xs font-mono transition-all ${
            idx === 0
              ? 'active bg-racing-blue text-white font-bold shadow-lg shadow-racing-blue/20'
              : 'bg-racing-surface border border-racing-border text-racing-muted hover:text-white hover:bg-racing-surface2'
          }`}
          data-module={m.value}
        >
          {m.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Car Cards Grid -->
  <div id="cars-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 py-8">
    {vehiclesData.map((car) => (
      <div
        class="car-item"
        data-module={car.module}
        data-search={`${car.name} ${car.manufacturer || ''} ${car.category} ${car.class_badge} ${car.drivetrain} ${car.module} ${car.id} ${car.id.startsWith('rally_') ? 'rally rallycross' : ''} ${car.module === 'Extreme Off-Road & Arenas' ? 'all terrain all-terrain offroad off-road' : ''} ${car.module === 'NASCAR Stock Car Racing' ? 'stock cars stockcar nascar' : ''} ${car.module === 'classic' ? 'arcade classic' : ''} ${car.module === 'Autocross' || car.id.startsWith('autocross_') ? 'autocross ax dirt buggy crosscar cross-car' : ''}`.toLowerCase()}
      >
        <CarCard car={car} />
      </div>
    ))}

    <div id="no-cars-notice" class="hidden col-span-full py-16 text-center">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-racing-surface border border-racing-border text-2xl mb-3">
        🏁
      </div>
      <h3 class="text-lg font-bold text-white font-mono">No Vehicles Found</h3>
      <p class="text-xs text-racing-muted font-mono mt-1" id="no-cars-msg">
        No vehicles currently match the selected module or search query.
      </p>
    </div>
  </div>
</Layout>

<script>
  function initVehicleFilters() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const searchInput = document.getElementById('car-search') as HTMLInputElement;
    const items = document.querySelectorAll('.car-item');
    const noCarsNotice = document.getElementById('no-cars-notice');
    const noCarsMsg = document.getElementById('no-cars-msg');

    let currentModule = 'All Modules';
    let searchQuery = '';

    function applyFilter() {
      let visibleCount = 0;
      items.forEach((el) => {
        const item = el as HTMLElement;
        const itemModule = item.dataset.module || '';
        const itemSearch = item.dataset.search || '';

        const matchesModule =
          currentModule === 'All Modules' ||
          currentModule === 'All modules' ||
          itemModule === currentModule ||
          (currentModule === 'classic' && (itemModule === 'classic' || itemModule === 'Classic Arcade Motorsport' || itemModule === 'Arcade')) ||
          (currentModule === 'Arcade' && (itemModule === 'classic' || itemModule === 'Classic Arcade Motorsport' || itemModule === 'Arcade')) ||
          (currentModule === 'Karting & Micro-Racers' && (itemModule === 'Karting & Micro-Racers' || itemModule === 'Karting' || itemModule === 'kart')) ||
          (currentModule === 'Karting' && (itemModule === 'Karting & Micro-Racers' || itemModule === 'Karting' || itemModule === 'kart')) ||
          (currentModule === 'Rallycross' && (itemModule === 'Rallycross' || itemModule === 'Rallycross & All-Terrain' || itemModule === 'rally')) ||
          (currentModule === 'Autocross' && (itemModule === 'Autocross' || itemModule === 'FIA Autocross' || itemModule === 'autocross')) ||
          (currentModule === 'Extreme Off-Road & Arenas' && (itemModule === 'Extreme Off-Road & Arenas' || itemModule === 'All terrain' || itemModule === 'All-Terrain' || itemModule === 'extreme_offroad' || itemModule === 'offroad')) ||
          ((currentModule === 'All terrain' || currentModule === 'All-Terrain') && (itemModule === 'Extreme Off-Road & Arenas' || itemModule === 'All terrain' || itemModule === 'All-Terrain' || itemModule === 'extreme_offroad' || itemModule === 'offroad')) ||
          (currentModule === 'Gran Turismo & Endurance' && (itemModule === 'Gran Turismo & Endurance' || itemModule === 'Gran Turismo' || itemModule === 'gt')) ||
          (currentModule === 'Gran Turismo' && (itemModule === 'Gran Turismo & Endurance' || itemModule === 'Gran Turismo' || itemModule === 'gt')) ||
          (currentModule === 'NASCAR Stock Car Racing' && (itemModule === 'NASCAR Stock Car Racing' || itemModule === 'Stock cars' || itemModule === 'nascar')) ||
          (currentModule === 'Stock cars' && (itemModule === 'NASCAR Stock Car Racing' || itemModule === 'Stock cars' || itemModule === 'nascar'));
        const matchesSearch = searchQuery === '' || itemSearch.includes(searchQuery.toLowerCase());

        if (matchesModule && matchesSearch) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (noCarsNotice) {
        if (visibleCount === 0) {
          noCarsNotice.classList.remove('hidden');
          if (noCarsMsg) noCarsMsg.textContent = 'No vehicles currently match the selected filter or search query.';
        } else {
          noCarsNotice.classList.add('hidden');
        }
      }
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        filterBtns.forEach((b) => {
          b.classList.remove('active', 'bg-racing-blue', 'text-white', 'font-bold', 'shadow-lg');
          b.classList.add('bg-racing-surface', 'border', 'border-racing-border', 'text-racing-muted');
        });
        target.classList.add('active', 'bg-racing-blue', 'text-white', 'font-bold', 'shadow-lg');
        target.classList.remove('text-racing-muted', 'bg-racing-surface');

        currentModule = target.dataset.module || 'All Modules';
        applyFilter();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value.trim();
        applyFilter();
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVehicleFilters);
  } else {
    initVehicleFilters();
  }
</script>
