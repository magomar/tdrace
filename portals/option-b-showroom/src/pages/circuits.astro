---
import Layout from '../layouts/Layout.astro';
import CircuitCard from '../components/CircuitCard.astro';
import circuitsData from '../../../shared/data/circuits.json';

const categories = ['all', 'f1', 'gt', 'nascar', 'rally', 'kart', 'classic'];
---

<Layout title="World Circuit & Track Directory" description="Explore 89 homologated circuit layouts across Formula 1, NASCAR speedways, World RX stages, and sprint kart arenas.">
  <div class="py-6 border-b border-racing-border">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-extrabold text-white tracking-tight">World Circuit Explorer</h1>
        <p class="text-sm text-racing-muted font-mono mt-1">
          {circuitsData.length} vector tracks with surface compositions, Joker Laps, and jump ramps.
        </p>
      </div>

      <!-- Search Input -->
      <div class="w-full md:w-72">
        <input
          type="text"
          id="circuit-search"
          placeholder="Search by venue name, category..."
          class="w-full px-4 py-2 bg-racing-surface border border-racing-border rounded-lg text-xs font-mono text-white placeholder-racing-muted focus:outline-none focus:border-racing-blue"
        />
      </div>
    </div>

    <!-- Category Filters -->
    <div class="flex flex-wrap gap-2 mt-6">
      {categories.map((cat, idx) => (
        <button
          type="button"
          class={`cat-btn px-3 py-1.5 rounded-lg text-xs font-mono uppercase transition-all ${
            idx === 0
              ? 'active bg-racing-blue text-white font-bold shadow-lg shadow-racing-blue/20'
              : 'bg-racing-surface border border-racing-border text-racing-muted hover:text-white hover:bg-racing-surface2'
          }`}
          data-category={cat}
        >
          {cat === 'all' ? 'All Modalities' : cat}
        </button>
      ))}
    </div>
  </div>

  <!-- Circuits Grid -->
  <div id="circuits-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 py-8">
    {circuitsData.map((c) => (
      <div class="circuit-item" data-category={c.category} data-search={`${c.name} ${c.category} ${c.modality} ${c.surfaces.join(' ')}`.toLowerCase()}>
        <CircuitCard circuit={c} />
      </div>
    ))}
  </div>
</Layout>

<script>
  function initCircuitFilters() {
    const catBtns = document.querySelectorAll('.cat-btn');
    const searchInput = document.getElementById('circuit-search') as HTMLInputElement;
    const items = document.querySelectorAll('.circuit-item');

    let currentCat = 'all';
    let searchQuery = '';

    function applyFilter() {
      items.forEach((el) => {
        const item = el as HTMLElement;
        const itemCat = item.dataset.category || '';
        const itemSearch = item.dataset.search || '';

        const matchesCat = currentCat === 'all' || itemCat === currentCat;
        const matchesSearch = searchQuery === '' || itemSearch.includes(searchQuery.toLowerCase());

        if (matchesCat && matchesSearch) {
          item.style.display = '';
        } else {
          item.style.display = 'none';
        }
      });
    }

    catBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        catBtns.forEach((b) => {
          b.classList.remove('active', 'bg-racing-blue', 'text-white', 'font-bold', 'shadow-lg');
          b.classList.add('bg-racing-surface', 'border', 'border-racing-border', 'text-racing-muted');
        });
        target.classList.add('active', 'bg-racing-blue', 'text-white', 'font-bold', 'shadow-lg');
        target.classList.remove('text-racing-muted', 'bg-racing-surface');

        currentCat = target.dataset.category || 'all';
        applyFilter();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value.trim();
        applyFilter();
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCircuitFilters);
  } else {
    initCircuitFilters();
  }
</script>
