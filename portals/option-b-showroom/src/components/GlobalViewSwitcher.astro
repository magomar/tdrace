---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`inline-flex items-center bg-racing-surface border border-racing-border rounded-lg p-1 text-xs font-mono shadow-inner ${className}`} data-global-switcher>
  <span class="text-racing-muted px-2 hidden sm:inline text-[10px] uppercase font-bold tracking-wider">View:</span>
  <button
    type="button"
    class="global-view-btn px-3 py-1.5 rounded font-semibold text-white bg-racing-blue transition-all shadow-sm"
    data-view="lateral"
  >
    Side
  </button>
  <button
    type="button"
    class="global-view-btn px-3 py-1.5 rounded text-racing-muted hover:text-white transition-all"
    data-view="topdown"
  >
    Top
  </button>
  <button
    type="button"
    class="global-view-btn px-3 py-1.5 rounded text-racing-muted hover:text-white transition-all"
    data-view="ref"
  >
    Real
  </button>
</div>

<script>
  function initGlobalSwitcher() {
    const switchers = document.querySelectorAll('[data-global-switcher]');
    switchers.forEach((switcher) => {
      const buttons = switcher.querySelectorAll<HTMLButtonElement>('.global-view-btn');
      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const view = btn.dataset.view;
          if (!view) return;

          document.querySelectorAll('.global-view-btn').forEach((b) => {
            const btnEl = b as HTMLButtonElement;
            if (btnEl.dataset.view === view) {
              btnEl.classList.add('text-white', 'bg-racing-blue', 'font-semibold', 'shadow-sm');
              btnEl.classList.remove('text-racing-muted');
            } else {
              btnEl.classList.remove('text-white', 'bg-racing-blue', 'font-semibold', 'shadow-sm');
              btnEl.classList.add('text-racing-muted');
            }
          });

          window.dispatchEvent(new CustomEvent('showroom-view-change', { detail: { view } }));
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGlobalSwitcher);
  } else {
    initGlobalSwitcher();
  }
</script>
