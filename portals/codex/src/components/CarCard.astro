---
import { moduleBadge, pct, type Car } from '../lib/codex';

interface Props {
  car: Car;
}

const { car } = Astro.props;

const moduleColor = moduleBadge(car.module);
const images = car.images;
const hasVisuals = Boolean(images.lateral || images.topdown || images.reference);

const isWideTrack = ['kart', 'extreme_offroad', 'autocross'].includes(car.module) || car.id === 'classic_kart';
const topdownCropStyle = isWideTrack
  ? 'object-view-box: inset(12% 0% 12% 0%);'
  : 'object-view-box: inset(18% 0% 18% 0%);';

const availableCount = [images.lateral, images.topdown, images.reference].filter(Boolean).length;
const showButtons = availableCount > 1;

const assetVersion = '?v=20260922d';
const imageLateralSrc = images.lateral ? `${images.lateral}${assetVersion}` : null;
const imageTopdownSrc = images.topdown ? `${images.topdown}${assetVersion}` : null;
const imageRefSrc = images.reference ? `${images.reference}${assetVersion}` : null;

// Game values from the car's CarConfig.
const brakesKn = (car.physics.max_brake_force / 1000).toFixed(1);
const downforce = car.physics.downforce_coefficient;
const drag = car.physics.air_drag_coefficient;
const stats = {
  speed: pct(car.stats.speed),
  acceleration: pct(car.stats.acceleration),
  grip: pct(car.stats.grip),
  agility: pct(car.stats.agility),
  braking: pct(car.stats.braking),
  aero: pct(car.stats.aero),
};
---

<div class="bg-racing-surface rounded-xl border border-racing-border overflow-hidden hover:border-racing-blue/50 hover:shadow-xl hover:shadow-racing-blue/5 transition-all flex flex-col justify-between group">
  <!-- Top Header -->
  <div class="p-5 border-b border-racing-border/60">
    <div class="flex items-center justify-between gap-2 mb-2.5">
      <span class={`text-xs px-2.5 py-0.5 rounded-full border font-mono font-semibold ${moduleColor}`}>
        T{car.tier} • {car.category_name}
      </span>
      <span class="text-xs font-mono text-racing-muted bg-racing-surface2 px-2 py-0.5 rounded border border-racing-border/40">
        {car.drivetrain}
      </span>
    </div>
    <h3 class="text-lg font-bold text-white group-hover:text-racing-cyan transition-colors tracking-tight">
      <a href={`/showroom/cars/${car.id}`} class="hover:underline">{car.name}</a>
    </h3>
    <p class="text-xs text-racing-muted mt-1 font-mono">
      {car.manufacturer} • {car.year}
    </p>
  </div>

  <!-- Dual-View Visual Showcase (2D Game Asset & Real Motorsport Reference) -->
  <div class="relative bg-racing-bg/80 border-b border-racing-border/60 overflow-hidden h-44 flex flex-col justify-between p-3 group/view" data-car-id={car.id}>
    {hasVisuals ? (
      <>
        {showButtons && (
          <div class="absolute top-2.5 right-2.5 z-10 flex gap-1 bg-racing-surface/90 border border-racing-border/80 rounded-md p-0.5 shadow-md text-[10px] font-mono">
            {images.lateral && (
              <button
                type="button"
                class="view-toggle-btn px-2 py-0.5 rounded text-white bg-racing-blue font-semibold transition-all active-toggle"
                data-target="lateral"
                data-car={car.id}
              >
                Side
              </button>
            )}
            {images.topdown && (
              <button
                type="button"
                class="view-toggle-btn px-2 py-0.5 rounded text-racing-muted hover:text-white transition-all"
                data-target="topdown"
                data-car={car.id}
              >
                Top
              </button>
            )}
            {images.reference && (
              <button
                type="button"
                class="view-toggle-btn px-2 py-0.5 rounded text-racing-muted hover:text-white transition-all"
                data-target="ref"
                data-car={car.id}
              >
                Real
              </button>
            )}
          </div>
        )}

        <div class="view-pane flex-1 flex items-center justify-center relative w-full h-full" id={`pane-lateral-${car.id}`}>
          {imageLateralSrc ? (
            <div class="relative w-full h-full flex flex-col items-center justify-center p-2">
              <img
                src={imageLateralSrc}
                alt={`${car.name} Side View`}
                class="max-h-28 w-auto object-contain drop-shadow-[0_12px_16px_rgba(0,0,0,0.6)] group-hover:scale-105 transition-transform duration-300"
                decoding="async"
              />
              <div class="w-3/4 h-1 bg-gradient-to-r from-transparent via-cyan-500/30 to-transparent blur-[1px] mt-1"></div>
            </div>
          ) : (
            <div class="text-xs font-mono text-racing-muted/60 italic">Side View Pending</div>
          )}
        </div>

        {imageTopdownSrc && (
          <div class="view-pane flex-1 hidden items-center justify-center relative w-full h-full" id={`pane-topdown-${car.id}`}>
            <div class="relative w-full h-full flex flex-col items-center justify-center p-2">
              <img
                src={imageTopdownSrc}
                alt={`${car.name} Top View`}
                class="max-h-28 w-auto object-contain drop-shadow-[0_12px_16px_rgba(0,0,0,0.6)] group-hover:scale-105 transition-transform duration-300"
                style={topdownCropStyle}
                decoding="async"
              />
              <div class="w-3/4 h-1 bg-gradient-to-r from-transparent via-cyan-500/30 to-transparent blur-[1px] mt-1"></div>
            </div>
          </div>
        )}

        {imageRefSrc && (
          <div class="view-pane flex-1 hidden items-center justify-center relative w-full h-full overflow-hidden rounded" id={`pane-ref-${car.id}`}>
            <img
              src={imageRefSrc}
              alt={`${car.name} Real Motorsport Reference`}
              class="w-full h-full object-cover rounded border border-racing-border/40"
              decoding="async"
            />
            <div class="absolute bottom-1 right-2 text-[9px] font-mono bg-black/60 px-1.5 py-0.5 rounded text-white/80">
              Real Trackside
            </div>
          </div>
        )}
      </>
    ) : (
      <div class="flex-1 flex flex-col items-center justify-center text-center p-4">
        <div class="w-16 h-8 border border-dashed border-racing-border rounded-md flex items-center justify-center text-[10px] font-mono text-racing-muted">
          CAD 2D
        </div>
        <div class="text-[11px] font-mono text-racing-muted/70 mt-2">
          {car.category_name} • Blueprint Spec
        </div>
      </div>
    )}
  </div>

  <!-- Key Specs Grid -->
  <div class="grid grid-cols-3 gap-2 px-5 py-3.5 bg-racing-surface2/40 border-b border-racing-border/40 text-center font-mono text-xs">
    <div>
      <div class="text-racing-muted text-[10px] uppercase">Power</div>
      <div class="font-bold text-racing-text mt-0.5">{car.bhp} BHP</div>
    </div>
    <div class="border-x border-racing-border/40">
      <div class="text-racing-muted text-[10px] uppercase">Weight</div>
      <div class="font-bold text-racing-text mt-0.5">{car.weight_kg} kg</div>
    </div>
    <div>
      <div class="text-racing-muted text-[10px] uppercase">Top Speed</div>
      <div class="font-bold text-racing-cyan mt-0.5">{car.top_speed_kmh} km/h</div>
    </div>
  </div>

  <!-- Engine & Acceleration Sub-Banner -->
  {car.engine_desc && (
    <div class="px-5 py-2 bg-racing-surface2/70 border-b border-racing-border/40 text-[11px] font-mono text-racing-muted flex justify-between items-center">
      <span class="truncate max-w-[210px]" title={car.engine_desc}>⚙️ {car.engine_desc}</span>
      {car.accel_0_100 > 0 && (
        <span class="text-racing-cyan font-bold whitespace-nowrap ml-2">0-100: {car.accel_0_100}s</span>
      )}
    </div>
  )}

  <!-- Performance Stat Bars (6-Dimensional Telemetry) -->
  <div class="p-4 space-y-1.5 flex-1 flex flex-col justify-center">
    <!-- 1. Speed -->
    <div class="relative group/stat flex items-center gap-2 text-[11px] font-mono py-0.5">
      <div class="w-24 flex items-center gap-1.5 shrink-0 text-slate-400">
        <svg class="w-3.5 h-3.5 text-cyan-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 14v-4" />
          <path d="M3.34 17a10 10 0 1 1 17.32 0" />
        </svg>
        <span class="truncate">Speed</span>
      </div>
      <div class="flex-1 h-1.5 bg-slate-800 rounded-full overflow-hidden">
        <div class="h-full bg-cyan-400 rounded-full transition-all" style={`width: ${stats.speed}%`}></div>
      </div>
      <div class="w-10 text-right font-bold text-slate-200 shrink-0">
        {stats.speed}%
      </div>
      <div class="pointer-events-none absolute left-1/2 -top-7 -translate-x-1/2 opacity-0 group-hover/stat:opacity-100 transition-opacity bg-slate-900/95 text-slate-200 border border-slate-700/80 px-2 py-0.5 rounded shadow-lg text-[10px] whitespace-nowrap z-30 font-sans">
        Top Speed: {car.top_speed_kmh} km/h
      </div>
    </div>

    <!-- 2. Accel -->
    <div class="relative group/stat flex items-center gap-2 text-[11px] font-mono py-0.5">
      <div class="w-24 flex items-center gap-1.5 shrink-0 text-slate-400">
        <svg class="w-3.5 h-3.5 text-amber-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
        </svg>
        <span class="truncate">Accel</span>
      </div>
      <div class="flex-1 h-1.5 bg-slate-800 rounded-full overflow-hidden">
        <div class="h-full bg-amber-400 rounded-full transition-all" style={`width: ${stats.acceleration}%`}></div>
      </div>
      <div class="w-10 text-right font-bold text-slate-200 shrink-0">
        {stats.acceleration}%
      </div>
      <div class="pointer-events-none absolute left-1/2 -top-7 -translate-x-1/2 opacity-0 group-hover/stat:opacity-100 transition-opacity bg-slate-900/95 text-slate-200 border border-slate-700/80 px-2 py-0.5 rounded shadow-lg text-[10px] whitespace-nowrap z-30 font-sans">
        0-100: {car.accel_0_100 ? `${car.accel_0_100}s` : 'N/A'} ({car.bhp} BHP)
      </div>
    </div>

    <!-- 3. Grip -->
    <div class="relative group/stat flex items-center gap-2 text-[11px] font-mono py-0.5">
      <div class="w-24 flex items-center gap-1.5 shrink-0 text-slate-400">
        <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 7a5 5 0 0 1 5 5" />
          <circle cx="12" cy="12" r="2" fill="currentColor" />
        </svg>
        <span class="truncate">Grip</span>
      </div>
      <div class="flex-1 h-1.5 bg-slate-800 rounded-full overflow-hidden">
        <div class="h-full bg-emerald-500 rounded-full transition-all" style={`width: ${stats.grip}%`}></div>
      </div>
      <div class="w-10 text-right font-bold text-slate-200 shrink-0">
        {stats.grip}%
      </div>
      <div class="pointer-events-none absolute left-1/2 -top-7 -translate-x-1/2 opacity-0 group-hover/stat:opacity-100 transition-opacity bg-slate-900/95 text-slate-200 border border-slate-700/80 px-2 py-0.5 rounded shadow-lg text-[10px] whitespace-nowrap z-30 font-sans">
        Grip rating: {stats.grip}%
      </div>
    </div>

    <!-- 4. Agility -->
    <div class="relative group/stat flex items-center gap-2 text-[11px] font-mono py-0.5">
      <div class="w-24 flex items-center gap-1.5 shrink-0 text-slate-400">
        <svg class="w-3.5 h-3.5 text-fuchsia-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 4c5 0 5 8 10 8s5 8 0 8" />
          <circle cx="7" cy="4" r="1.5" fill="currentColor" />
          <circle cx="17" cy="20" r="1.5" fill="currentColor" />
        </svg>
        <span class="truncate">Agility</span>
      </div>
      <div class="flex-1 h-1.5 bg-slate-800 rounded-full overflow-hidden">
        <div class="h-full bg-fuchsia-500 rounded-full transition-all" style={`width: ${stats.agility}%`}></div>
      </div>
      <div class="w-10 text-right font-bold text-slate-200 shrink-0">
        {stats.agility}%
      </div>
      <div class="pointer-events-none absolute left-1/2 -top-7 -translate-x-1/2 opacity-0 group-hover/stat:opacity-100 transition-opacity bg-slate-900/95 text-slate-200 border border-slate-700/80 px-2 py-0.5 rounded shadow-lg text-[10px] whitespace-nowrap z-30 font-sans">
        Steering Agility: {stats.agility}%
      </div>
    </div>

    <!-- 5. Braking -->
    <div class="relative group/stat flex items-center gap-2 text-[11px] font-mono py-0.5">
      <div class="w-24 flex items-center gap-1.5 shrink-0 text-slate-400">
        <svg class="w-3.5 h-3.5 text-orange-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2" />
          <line x1="7" y1="12" x2="17" y2="12" />
        </svg>
        <span class="truncate">Braking</span>
      </div>
      <div class="flex-1 h-1.5 bg-slate-800 rounded-full overflow-hidden">
        <div class="h-full bg-orange-500 rounded-full transition-all" style={`width: ${stats.braking}%`}></div>
      </div>
      <div class="w-10 text-right font-bold text-slate-200 shrink-0">
        {brakesKn}k
      </div>
      <div class="pointer-events-none absolute left-1/2 -top-7 -translate-x-1/2 opacity-0 group-hover/stat:opacity-100 transition-opacity bg-slate-900/95 text-slate-200 border border-slate-700/80 px-2 py-0.5 rounded shadow-lg text-[10px] whitespace-nowrap z-30 font-sans">
        Braking: {car.brakes_desc} ({brakesKn} kN in game)
      </div>
    </div>

    <!-- 6. Downforce / Aero -->
    <div class="relative group/stat flex items-center gap-2 text-[11px] font-mono py-0.5">
      <div class="w-24 flex items-center gap-1.5 shrink-0 text-slate-400">
        <svg class="w-3.5 h-3.5 text-white shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 8c6-2 12-2 18 0l-2 3c-5-1.5-9-1.5-14 0z" />
          <path d="M7 11v5" />
          <path d="M17 11v5" />
          <path d="M12 11v7" />
          <path d="M9 16l3 3 3-3" />
        </svg>
        <span class="truncate">Downforce</span>
      </div>
      <div class="flex-1 h-1.5 bg-slate-800 rounded-full overflow-hidden">
        <div class="h-full bg-white rounded-full transition-all" style={`width: ${stats.aero}%`}></div>
      </div>
      <div class="w-10 text-right font-bold text-slate-200 shrink-0">
        {downforce.toFixed(2)}
      </div>
      <div class="pointer-events-none absolute left-1/2 -top-7 -translate-x-1/2 opacity-0 group-hover/stat:opacity-100 transition-opacity bg-slate-900/95 text-slate-200 border border-slate-700/80 px-2 py-0.5 rounded shadow-lg text-[10px] whitespace-nowrap z-30 font-sans">
        Game aero: downforce {downforce.toFixed(2)} / drag {drag.toFixed(2)}
      </div>
    </div>
  </div>

  <!-- Summary Footer -->
  <div class="px-5 py-3 bg-racing-surface2/60 border-t border-racing-border text-xs text-racing-muted italic">
    "{car.history_bio}"
  </div>

  <!-- Detail & Compare Actions -->
  <div class="px-5 py-2.5 bg-racing-surface2/80 border-t border-racing-border/50 flex items-center justify-between text-xs font-mono">
    <a href={`/showroom/compare?car1=${car.id}`} class="text-racing-muted hover:text-white transition-colors flex items-center gap-1">
      <span>⚖️</span> Compare
    </a>
    <a href={`/showroom/cars/${car.id}`} class="text-racing-cyan hover:underline font-semibold flex items-center gap-1">
      <span>Details</span> <span>→</span>
    </a>
  </div>
</div>

<script>
  function switchCardView(card: HTMLElement, targetView: string) {
    const carId = card.dataset.carId;
    if (!carId) return;

    const paneLateral = card.querySelector<HTMLElement>(`#pane-lateral-${carId}`);
    const paneTopdown = card.querySelector<HTMLElement>(`#pane-topdown-${carId}`);
    const paneRef = card.querySelector<HTMLElement>(`#pane-ref-${carId}`);

    let effectiveView = targetView;
    if (effectiveView === 'ref' && !paneRef) {
      effectiveView = 'lateral';
    } else if (effectiveView === 'topdown' && !paneTopdown) {
      effectiveView = 'lateral';
    } else if (effectiveView === 'lateral' && !paneLateral) {
      effectiveView = paneTopdown ? 'topdown' : 'ref';
    }

    const panes = [
      { view: 'lateral', el: paneLateral },
      { view: 'topdown', el: paneTopdown },
      { view: 'ref', el: paneRef },
    ];

    panes.forEach(({ view, el }) => {
      if (!el) return;
      if (view === effectiveView) {
        el.classList.remove('hidden');
        el.classList.add('flex');
        const img = el.querySelector('img');
        if (img && img.loading === 'lazy') {
          img.loading = 'eager';
        }
      } else {
        el.classList.add('hidden');
        el.classList.remove('flex');
      }
    });

    const buttons = card.querySelectorAll<HTMLButtonElement>('.view-toggle-btn');
    buttons.forEach((b) => {
      if (b.dataset.target === effectiveView) {
        b.classList.add('text-white', 'bg-racing-blue', 'font-semibold', 'active-toggle');
        b.classList.remove('text-racing-muted');
      } else {
        b.classList.remove('text-white', 'bg-racing-blue', 'font-semibold', 'active-toggle');
        b.classList.add('text-racing-muted');
      }
    });
  }

  function initViewToggles() {
    document.querySelectorAll<HTMLElement>('[data-car-id]').forEach((card) => {
      card.querySelectorAll<HTMLButtonElement>('.view-toggle-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const viewMode = btn.dataset.target;
          if (viewMode) {
            switchCardView(card, viewMode);
          }
        });
      });
    });

    window.addEventListener('showroom-view-change', ((e: CustomEvent<{ view: string }>) => {
      const targetView = e.detail?.view;
      if (!targetView) return;
      document.querySelectorAll<HTMLElement>('[data-car-id]').forEach((card) => {
        switchCardView(card, targetView);
      });
    }) as EventListener);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initViewToggles);
  } else {
    initViewToggles();
  }
</script>
