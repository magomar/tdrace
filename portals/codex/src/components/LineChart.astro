---
// Server-rendered SVG line chart for curves exported from the game (no client script).
interface Series {
  label: string;
  color: string;
  points: [number, number][];
}

interface Props {
  series: Series[];
  xLabel: string;
  yLabel: string;
  xDomain?: [number, number];
  yDomain?: [number, number];
  /** Vertical marker lines, e.g. a peak or a threshold. */
  markers?: { x: number; label: string }[];
  xFormat?: (x: number) => string;
  yFormat?: (y: number) => string;
}

const { series, xLabel, yLabel, markers = [], xFormat = (x) => `${+x.toFixed(2)}`, yFormat = (y) => `${+y.toFixed(2)}` } =
  Astro.props;

const all = series.flatMap((s) => s.points);
const [x0, x1] = Astro.props.xDomain ?? [Math.min(...all.map((p) => p[0])), Math.max(...all.map((p) => p[0]))];
const [y0, y1] = Astro.props.yDomain ?? [Math.min(0, ...all.map((p) => p[1])), Math.max(...all.map((p) => p[1]))];

const W = 640;
const H = 260;
const PAD = { l: 52, r: 16, t: 14, b: 40 };
const sx = (x: number) => PAD.l + ((x - x0) / (x1 - x0 || 1)) * (W - PAD.l - PAD.r);
const sy = (y: number) => H - PAD.b - ((y - y0) / (y1 - y0 || 1)) * (H - PAD.t - PAD.b);
const ticks = (a: number, b: number) => Array.from({ length: 5 }, (_, i) => a + ((b - a) * i) / 4);
const path = (pts: [number, number][]) =>
  pts.map(([x, y], i) => `${i ? 'L' : 'M'}${sx(x).toFixed(1)},${sy(y).toFixed(1)}`).join(' ');
---

<figure class="rounded-xl border border-racing-border bg-racing-surface p-4">
  <svg viewBox={`0 0 ${W} ${H}`} class="w-full h-auto" role="img" aria-label={`${yLabel} against ${xLabel}`}>
    {ticks(y0, y1).map((y) => (
      <g>
        <line x1={PAD.l} x2={W - PAD.r} y1={sy(y)} y2={sy(y)} stroke="#272d3e" stroke-dasharray="3 3" />
        <text x={PAD.l - 6} y={sy(y) + 4} text-anchor="end" font-size="11" fill="#94a3b8" font-family="JetBrains Mono, monospace">
          {yFormat(y)}
        </text>
      </g>
    ))}
    {ticks(x0, x1).map((x) => (
      <text x={sx(x)} y={H - PAD.b + 16} text-anchor="middle" font-size="11" fill="#94a3b8" font-family="JetBrains Mono, monospace">
        {xFormat(x)}
      </text>
    ))}
    <line x1={PAD.l} x2={W - PAD.r} y1={H - PAD.b} y2={H - PAD.b} stroke="#475569" />
    <line x1={PAD.l} x2={PAD.l} y1={PAD.t} y2={H - PAD.b} stroke="#475569" />
    {markers.map((m) => (
      <g>
        <line x1={sx(m.x)} x2={sx(m.x)} y1={PAD.t} y2={H - PAD.b} stroke="#f59e0b" stroke-dasharray="4 3" />
        <text x={sx(m.x) + 4} y={PAD.t + 10} font-size="10" fill="#f59e0b" font-family="JetBrains Mono, monospace">{m.label}</text>
      </g>
    ))}
    {series.map((s) => (
      <path d={path(s.points)} fill="none" stroke={s.color} stroke-width="2" stroke-linejoin="round" />
    ))}
    <text x={(PAD.l + W - PAD.r) / 2} y={H - 6} text-anchor="middle" font-size="11" fill="#cbd5e1" font-family="Inter, sans-serif">{xLabel}</text>
    <text x={12} y={(PAD.t + H - PAD.b) / 2} text-anchor="middle" font-size="11" fill="#cbd5e1" font-family="Inter, sans-serif" transform={`rotate(-90 12 ${(PAD.t + H - PAD.b) / 2})`}>{yLabel}</text>
  </svg>
  {series.length > 1 && (
    <figcaption class="flex flex-wrap gap-x-4 gap-y-1 mt-2 text-[11px] font-mono text-racing-muted">
      {series.map((s) => (
        <span class="flex items-center gap-1.5">
          <span class="w-3 h-0.5 rounded" style={`background:${s.color}`}></span>
          {s.label}
        </span>
      ))}
    </figcaption>
  )}
</figure>
