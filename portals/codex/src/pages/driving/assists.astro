---
import Layout from '../../layouts/Layout.astro';
import { getDrivingModel } from '../../lib/codex';

const driving = await getDrivingModel();

const ASSIST_BADGES: Record<string, { bg: string; text: string; border: string }> = {
  arcade: { bg: 'bg-green-500/15', text: 'text-green-400', border: 'border-green-500/30' },
  sport: { bg: 'bg-amber-500/15', text: 'text-amber-400', border: 'border-amber-500/30' },
  pro: { bg: 'bg-rose-500/15', text: 'text-rose-400', border: 'border-rose-500/30' },
};
---

<Layout title="Driver Assists" description="Electronic stability systems (TCS, ESC, ABS, Counter-Steer) and difficulty profiles.">
  <div class="py-6 border-b border-racing-border max-w-4xl">
    <p class="text-xs font-mono text-racing-cyan"><a href="/driving" class="hover:underline">Driving</a> / Assists</p>
    <h1 class="text-3xl font-extrabold text-white tracking-tight mt-1">Driver Assists & Stability Systems</h1>
    <p class="text-sm text-racing-muted mt-3 leading-relaxed">
      TDRace incorporates four independent closed-loop electronic vehicle aids:
      <strong class="text-white">Traction Control (TCS)</strong>,
      <strong class="text-white">Electronic Stability Control (ESC)</strong>,
      <strong class="text-white">Anti-Lock Braking (ABS)</strong>, and
      <strong class="text-white">Counter-Steer Assist</strong>.
      Three difficulty profiles govern their intervention thresholds, switchable instantly during racing with the <kbd class="px-1.5 py-0.5 rounded bg-racing-card border border-racing-border text-racing-cyan font-mono text-xs">H</kbd> key.
    </p>
  </div>

  <!-- Profiles Overview Cards -->
  <section class="py-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {driving.assist_profiles.map((profile) => {
        const badge = ASSIST_BADGES[profile.id] ?? ASSIST_BADGES.arcade;
        return (
          <div class="rounded-xl border border-racing-border bg-racing-surface p-5 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 border-b border-racing-border/60 pb-3">
                <h2 class="text-lg font-bold text-white">{profile.name}</h2>
                <span class={`text-[11px] font-mono px-2 py-0.5 rounded-full border ${badge.bg} ${badge.text} ${badge.border}`}>
                  {profile.title.split(': ')[1]?.replace(')', '') ?? profile.short_name}
                </span>
              </div>

              <p class="text-xs text-racing-muted mt-3 leading-relaxed min-h-[48px]">
                {profile.description}
              </p>

              <!-- State summary pills -->
              <div class="grid grid-cols-2 gap-2 mt-4 text-xs font-mono">
                <div class={`p-2 rounded-lg border flex items-center justify-between ${profile.tcs_enabled ? 'bg-green-500/10 border-green-500/20 text-green-300' : 'bg-racing-card/40 border-racing-border/40 text-racing-muted'}`}>
                  <span>TCS</span>
                  <span class="font-bold">{profile.tcs_enabled ? `${(profile.tcs_strength * 100).toFixed(0)}%` : 'OFF'}</span>
                </div>
                <div class={`p-2 rounded-lg border flex items-center justify-between ${profile.esc_enabled ? 'bg-cyan-500/10 border-cyan-500/20 text-cyan-300' : 'bg-racing-card/40 border-racing-border/40 text-racing-muted'}`}>
                  <span>ESC</span>
                  <span class="font-bold">{profile.esc_enabled ? `${(profile.esc_strength * 100).toFixed(0)}%` : 'OFF'}</span>
                </div>
                <div class={`p-2 rounded-lg border flex items-center justify-between ${profile.abs_enabled ? 'bg-amber-500/10 border-amber-500/20 text-amber-300' : 'bg-racing-card/40 border-racing-border/40 text-racing-muted'}`}>
                  <span>ABS</span>
                  <span class="font-bold">{profile.abs_enabled ? `${(profile.abs_strength * 100).toFixed(0)}%` : 'OFF'}</span>
                </div>
                <div class={`p-2 rounded-lg border flex items-center justify-between ${profile.counter_steer_assist_enabled ? 'bg-purple-500/10 border-purple-500/20 text-purple-300' : 'bg-racing-card/40 border-racing-border/40 text-racing-muted'}`}>
                  <span>Counter-Steer</span>
                  <span class="font-bold">{profile.counter_steer_assist_enabled ? `${(profile.counter_steer_assist_strength * 100).toFixed(0)}%` : 'OFF'}</span>
                </div>
              </div>
            </div>

            <div class="mt-4 pt-3 border-t border-racing-border/40 flex items-center justify-between text-[11px] font-mono text-racing-muted">
              <span>Drift Bypass:</span>
              <span class={profile.tcs_drift_bypass ? 'text-amber-400 font-semibold' : 'text-racing-muted'}>
                {profile.tcs_drift_bypass ? 'Active (Powerslides allowed)' : 'Strict limit'}
              </span>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- Complete Configuration Matrix -->
  <section class="py-8 border-t border-racing-border">
    <div class="max-w-3xl mb-6">
      <h2 class="text-xl font-bold text-white tracking-tight">Assists Parameter Matrix</h2>
      <p class="text-sm text-racing-muted mt-1 leading-relaxed">
        Exact thresholds extracted from <code class="text-racing-cyan font-mono text-xs">DriverAssistsConfig</code> used in the vehicle dynamics loop.
      </p>
    </div>

    <div class="overflow-x-auto rounded-xl border border-racing-border bg-racing-surface">
      <table class="w-full text-left text-xs font-mono">
        <thead class="bg-racing-card/80 text-[10px] text-racing-muted uppercase border-b border-racing-border">
          <tr>
            <th class="py-3 px-4 font-semibold">Subsystem & Threshold</th>
            <th class="py-3 px-4 font-semibold text-green-400">Arcade</th>
            <th class="py-3 px-4 font-semibold text-amber-400">Sport</th>
            <th class="py-3 px-4 font-semibold text-rose-400">Pro</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-racing-border/40">
          <!-- TCS -->
          <tr class="bg-racing-card/30">
            <td colspan="4" class="py-2 px-4 font-bold text-racing-cyan uppercase text-[10px]">Traction Control System (TCS)</td>
          </tr>
          <tr>
            <td class="py-2.5 px-4 text-white">TCS Active Status</td>
            <td class="py-2.5 px-4 text-green-300">Enabled</td>
            <td class="py-2.5 px-4 text-amber-300">Enabled</td>
            <td class="py-2.5 px-4 text-rose-300">Disabled</td>
          </tr>
          <tr>
            <td class="py-2.5 px-4 text-white">Slip Ratio Threshold (<code class="text-racing-cyan">tcs_slip_threshold</code>)</td>
            <td class="py-2.5 px-4">0.18 (18% wheelspin)</td>
            <td class="py-2.5 px-4">0.45 (45% wheelspin)</td>
            <td class="py-2.5 px-4 text-racing-muted">0.50 (N/A)</td>
          </tr>
          <tr>
            <td class="py-2.5 px-4 text-white">Torque Reduction Strength (<code class="text-racing-cyan">tcs_strength</code>)</td>
            <td class="py-2.5 px-4">75% torque cut</td>
            <td class="py-2.5 px-4">25% torque cut</td>
            <td class="py-2.5 px-4 text-racing-muted">0%</td>
          </tr>
          <tr>
            <td class="py-2.5 px-4 text-white">Max Slip Angle Limit (<code class="text-racing-cyan">tcs_slip_angle_deg</code>)</td>
            <td class="py-2.5 px-4">18.0°</td>
            <td class="py-2.5 px-4">32.0°</td>
            <td class="py-2.5 px-4 text-racing-muted">30.0° (N/A)</td>
          </tr>
          <tr>
            <td class="py-2.5 px-4 text-white">Handbrake Drift Bypass (<code class="text-racing-cyan">tcs_drift_bypass</code>)</td>
            <td class="py-2.5 px-4 text-racing-muted">False</td>
            <td class="py-2.5 px-4 text-amber-300 font-bold">True</td>
            <td class="py-2.5 px-4 text-racing-muted">False</td>
          </tr>

          <!-- ESC -->
          <tr class="bg-racing-card/30">
            <td colspan="4" class="py-2 px-4 font-bold text-racing-cyan uppercase text-[10px]">Electronic Stability Control (ESC)</td>
          </tr>
          <tr>
            <td class="py-2.5 px-4 text-white">ESC Active Status</td>
            <td class="py-2.5 px-4 text-green-300">Enabled</td>
            <td class="py-2.5 px-4 text-amber-300">Enabled</td>
            <td class="py-2.5 px-4 text-rose-300">Disabled</td>
          </tr>
          <tr>
            <td class="py-2.5 px-4 text-white">Yaw Rate Threshold (<code class="text-racing-cyan">esc_yaw_threshold</code>)</td>
            <td class="py-2.5 px-4">0.10 rad/s (tight)</td>
            <td class="py-2.5 px-4">0.40 rad/s (relaxed)</td>
            <td class="py-2.5 px-4 text-racing-muted">1.00 rad/s (N/A)</td>
          </tr>
          <tr>
            <td class="py-2.5 px-4 text-white">Yaw Damping Correction (<code class="text-racing-cyan">esc_strength</code>)</td>
            <td class="py-2.5 px-4">70% brake torque</td>
            <td class="py-2.5 px-4">30% brake torque</td>
            <td class="py-2.5 px-4 text-racing-muted">0%</td>
          </tr>
          <tr>
            <td class="py-2.5 px-4 text-white">Sideslip Limit Angle (<code class="text-racing-cyan">esc_sideslip_limit_deg</code>)</td>
            <td class="py-2.5 px-4">22.0°</td>
            <td class="py-2.5 px-4">38.0°</td>
            <td class="py-2.5 px-4 text-racing-muted">180.0°</td>
          </tr>

          <!-- Counter-Steer Assist -->
          <tr class="bg-racing-card/30">
            <td colspan="4" class="py-2 px-4 font-bold text-racing-cyan uppercase text-[10px]">Counter-Steer Assist</td>
          </tr>
          <tr>
            <td class="py-2.5 px-4 text-white">Counter-Steer Status</td>
            <td class="py-2.5 px-4 text-green-300">Enabled</td>
            <td class="py-2.5 px-4 text-amber-300">Enabled</td>
            <td class="py-2.5 px-4 text-rose-300">Disabled</td>
          </tr>
          <tr>
            <td class="py-2.5 px-4 text-white">Alignment Gain (<code class="text-racing-cyan">counter_steer_assist_strength</code>)</td>
            <td class="py-2.5 px-4">75% automatic rack correction</td>
            <td class="py-2.5 px-4">55% automatic rack correction</td>
            <td class="py-2.5 px-4 text-racing-muted">0% (Pure manual input)</td>
          </tr>

          <!-- ABS -->
          <tr class="bg-racing-card/30">
            <td colspan="4" class="py-2 px-4 font-bold text-racing-cyan uppercase text-[10px]">Anti-Lock Braking System (ABS)</td>
          </tr>
          <tr>
            <td class="py-2.5 px-4 text-white">ABS Active Status</td>
            <td class="py-2.5 px-4 text-green-300">Enabled</td>
            <td class="py-2.5 px-4 text-amber-300">Enabled</td>
            <td class="py-2.5 px-4 text-rose-300">Disabled</td>
          </tr>
          <tr>
            <td class="py-2.5 px-4 text-white">Wheel Lock Threshold (<code class="text-racing-cyan">abs_slip_threshold</code>)</td>
            <td class="py-2.5 px-4">0.15 (15% lock slip)</td>
            <td class="py-2.5 px-4">0.20 (20% lock slip)</td>
            <td class="py-2.5 px-4 text-racing-muted">0.50 (N/A)</td>
          </tr>
          <tr>
            <td class="py-2.5 px-4 text-white">Pressure Modulation (<code class="text-racing-cyan">abs_strength</code>)</td>
            <td class="py-2.5 px-4">95% modulation</td>
            <td class="py-2.5 px-4">75% modulation</td>
            <td class="py-2.5 px-4 text-racing-muted">0% (Full mechanical lock)</td>
          </tr>
          <tr>
            <td class="py-2.5 px-4 text-white">Handbrake Bypass (<code class="text-racing-cyan">handbrake_bypass</code>)</td>
            <td class="py-2.5 px-4 text-green-300 font-bold">True</td>
            <td class="py-2.5 px-4 text-amber-300 font-bold">True</td>
            <td class="py-2.5 px-4 text-rose-300 font-bold">True</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Deep Dive Technical Explanations -->
  <section class="py-8 border-t border-racing-border">
    <div class="max-w-3xl mb-6">
      <h2 class="text-xl font-bold text-white tracking-tight">How the Electronic Aids Work</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="rounded-xl border border-racing-border bg-racing-surface p-5">
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-green-400"></span>
          TCS: Traction Control System
        </h3>
        <p class="text-xs text-racing-muted mt-2 leading-relaxed">
          TCS monitors the rotational slip ratio of driven wheels relative to road surface speed.
          When wheelspin exceeds <code class="text-racing-cyan">tcs_slip_threshold</code>, engine drive force is scaled down proportionally to the configured strength.
          On Sport mode, <strong class="text-white">Drift Bypass</strong> detects intentional powerslides and suspends torque cutting, letting drivers maintain high-angle drifts without bogging down.
        </p>
      </div>

      <div class="rounded-xl border border-racing-border bg-racing-surface p-5">
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
          ESC: Electronic Stability Control
        </h3>
        <p class="text-xs text-racing-muted mt-2 leading-relaxed">
          ESC computes the difference between the driver's commanded heading and the car's actual velocity vector.
          If yaw divergence exceeds <code class="text-racing-cyan">esc_yaw_threshold</code> or sideslip crosses <code class="text-racing-cyan">esc_sideslip_limit_deg</code>, individual outside wheels apply differential braking torque to produce an opposing restorative moment, preventing snap oversteer spinouts.
        </p>
      </div>

      <div class="rounded-xl border border-racing-border bg-racing-surface p-5">
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
          ABS & Handbrake Bypass
        </h3>
        <p class="text-xs text-racing-muted mt-2 leading-relaxed">
          ABS pulses braking pressure to maintain tire rotation within the optimal longitudinal friction peak (15–20% slip ratio), preserving lateral steering authority even during emergency stops.
          Critically, <strong class="text-white">Handbrake Bypass</strong> is universally enabled: pulling the handbrake (<kbd class="px-1 py-0.5 rounded bg-racing-card border border-racing-border text-[10px]">Space</kbd>) overrides rear ABS, allowing crisp rear lockup for hairpin rotations and Scandinavian flicks.
        </p>
      </div>

      <div class="rounded-xl border border-racing-border bg-racing-surface p-5">
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-purple-400"></span>
          Counter-Steer Assist
        </h3>
        <p class="text-xs text-racing-muted mt-2 leading-relaxed">
          When the rear axle breaks into oversteer, Counter-Steer Assist automatically introduces a proportional corrective steering offset toward the velocity vector.
          This eliminates the high-speed snap pendulum effect common to keyboard driving while leaving primary line choice fully in the hands of the player.
        </p>
      </div>
    </div>
  </section>
</Layout>
