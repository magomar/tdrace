---
import Layout from '../../../layouts/Layout.astro';
import ChassisPlan from '../../../components/ChassisPlan.astro';
import {
  categoryLabel,
  deg,
  differentialLabel,
  getCars,
  getCompounds,
  getPlatforms,
  moduleBadge,
  moduleLabel,
  pct,
  rgba,
  ARCHETYPE_LABEL,
  PLACEMENT_LABEL,
  type Car,
} from '../../../lib/codex';

export async function getStaticPaths() {
  const cars = await getCars();
  return cars.map((car) => ({
    params: { id: car.id },
    props: { car },
  }));
}

interface Props {
  car: Car;
}

const { car } = Astro.props;

const [platforms, compounds] = await Promise.all([getPlatforms(), getCompounds()]);
const platform = platforms.find((p) => p.id === car.base_car) ?? platforms[0];

const moduleColor = moduleBadge(car.module);
const images = car.images;
const hasVisuals = Boolean(images.lateral || images.topdown || images.reference);

const isWideTrack = ['kart', 'extreme_offroad', 'autocross'].includes(car.module) || car.id === 'classic_kart';
const topdownCropStyle = isWideTrack
  ? 'object-view-box: inset(12% 0% 12% 0%);'
  : 'object-view-box: inset(18% 0% 18% 0%);';

const assetVersion = '?v=20260922d';
const imageLateralSrc = images.lateral ? `${images.lateral}${assetVersion}` : null;
const imageTopdownSrc = images.topdown ? `${images.topdown}${assetVersion}` : null;
const imageRefSrc = images.reference ? `${images.reference}${assetVersion}` : null;

// Game physics parameters
const physics = car.physics as any;
const brakesKn = (physics.max_brake_force / 1000).toFixed(1);
const engineForceN = Math.round(physics.max_engine_force);
const downforce = physics.downforce_coefficient;
const drag = physics.air_drag_coefficient;
const rollingResistance = physics.rolling_resistance_coefficient ?? 0.015;
const powerToWeight = (car.bhp / (car.weight_kg / 1000)).toFixed(1);
const weightToPower = (car.weight_kg / car.bhp).toFixed(2);

const stats = {
  speed: pct(car.stats.speed),
  acceleration: pct(car.stats.acceleration),
  grip: pct(car.stats.grip),
  agility: pct(car.stats.agility),
  braking: pct(car.stats.braking),
  aero: pct(car.stats.aero),
};

// Suspension details
const frontSusp = physics.suspension?.front ?? platform.suspension.front;
const rearSusp = physics.suspension?.rear ?? platform.suspension.rear;
const frontArb = physics.suspension?.front_arb_rate ?? platform.suspension.front_arb_rate;
const rearArb = physics.suspension?.rear_arb_rate ?? platform.suspension.rear_arb_rate;

// Wheel / Tyre details
const wheels = physics.wheels ?? platform.wheels;
const wheelFront = wheels[0] ?? { tire_radius: 0.33, tire_width: 0.22, rotational_inertia: 1.3 };
const wheelRear = wheels[2] ?? wheels[0];
const compoundObj = wheelFront.compound;
const compoundId = typeof compoundObj === 'object' ? compoundObj.id : (wheelFront.compound ?? 'HardSlick');
const compoundMatch = compounds.find((c) => c.id.toLowerCase() === String(compoundId).toLowerCase());
const compoundName = compoundMatch?.name ?? (typeof compoundObj === 'object' ? compoundObj.name : compoundId);
const compoundBadge = compoundMatch?.badge ?? 'SLK';
const compoundColor = compoundMatch ? rgba(compoundMatch.accent_rgba) : '#94a3b8';

// Drivetrain & Differential details
const enginePlacement = physics.engine_placement ?? platform.engine_placement;
const frontDiff = physics.front_differential ?? platform.front_differential;
const rearDiff = physics.rear_differential ?? platform.rear_differential;
const driveBias = physics.drive_bias;
const driveSplit = driveBias >= 0.99
  ? 'FWD (100% Front)'
  : driveBias <= 0.01
    ? 'RWD (100% Rear)'
    : `AWD (${Math.round(driveBias * 100)}% F / ${Math.round((1 - driveBias) * 100)}% R)`;

const frontWeightPct = Math.round((platform.cg_to_rear_m / platform.wheelbase_m) * 100);
const rearWeightPct = 100 - frontWeightPct;
---

<Layout title={`${car.name} — TDRace Codex`} description={`${car.name} (${car.year} ${car.manufacturer}) specifications, Pacejka physics, chassis dimensions, and telemetry.`}>
  <div class="py-6 border-b border-racing-border max-w-6xl">
    <div class="flex items-center justify-between gap-4 flex-wrap">
      <div>
        <p class="text-xs font-mono text-racing-cyan">
          <a href="/showroom" class="hover:underline">Showroom</a> / <a href="/showroom/cars" class="hover:underline">Cars</a> / {car.name}
        </p>
        <div class="flex items-center gap-3 mt-1 flex-wrap">
          <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">{car.name}</h1>
          <span class={`text-xs px-2.5 py-0.5 rounded-full border font-mono font-semibold ${moduleColor}`}>
            T{car.tier} • {car.category_name}
          </span>
          <span class="text-xs font-mono text-racing-muted bg-racing-surface2 px-2.5 py-0.5 rounded border border-racing-border/40">
            {car.drivetrain}
          </span>
        </div>
        <p class="text-sm text-racing-muted font-mono mt-1">
          {car.manufacturer} • {car.year} • {moduleLabel(car.module)} ({categoryLabel(car.category)})
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href={`/showroom/compare?car1=${car.id}`}
          class="px-4 py-2 rounded-lg bg-racing-blue hover:bg-racing-blue/80 text-white font-mono text-xs font-semibold shadow-lg shadow-racing-blue/20 transition-all flex items-center gap-1.5"
        >
          <span>⚖️</span> Compare car
        </a>
        <a
          href="/showroom/cars"
          class="px-4 py-2 rounded-lg bg-racing-surface hover:bg-racing-surface2 border border-racing-border text-racing-muted hover:text-white font-mono text-xs transition-all"
        >
          ← All cars
        </a>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 py-8 max-w-6xl">
    <!-- Left Column: Visuals & Spec Sheet (7 cols) -->
    <div class="lg:col-span-7 space-y-6">
      <!-- Visual Showcase Box -->
      <div class="rounded-xl border border-racing-border bg-racing-surface overflow-hidden">
        <div class="flex items-center justify-between p-4 border-b border-racing-border/60 bg-racing-surface2/30">
          <span class="text-xs font-mono uppercase text-racing-muted">Visual Spec</span>
          <div class="flex gap-1.5 bg-racing-surface border border-racing-border/80 rounded-md p-1 shadow-sm text-xs font-mono">
            {images.lateral && (
              <button
                type="button"
                class="detail-view-btn px-2.5 py-1 rounded text-white bg-racing-blue font-semibold transition-all"
                data-target="lateral"
              >
                Side View
              </button>
            )}
            {images.topdown && (
              <button
                type="button"
                class="detail-view-btn px-2.5 py-1 rounded text-racing-muted hover:text-white transition-all"
                data-target="topdown"
              >
                Top Plan
              </button>
            )}
            {images.reference && (
              <button
                type="button"
                class="detail-view-btn px-2.5 py-1 rounded text-racing-muted hover:text-white transition-all"
                data-target="ref"
              >
                Real Trackside
              </button>
            )}
          </div>
        </div>

        <div class="relative h-64 sm:h-72 flex items-center justify-center p-6 bg-racing-bg/90">
          {imageLateralSrc && (
            <div id="detail-pane-lateral" class="detail-pane w-full h-full flex flex-col items-center justify-center">
              <img
                src={imageLateralSrc}
                alt={`${car.name} Side View`}
                class="max-h-48 w-auto object-contain drop-shadow-[0_16px_24px_rgba(0,0,0,0.8)]"
              />
              <div class="w-2/3 h-1.5 bg-gradient-to-r from-transparent via-cyan-500/40 to-transparent blur-[2px] mt-4"></div>
            </div>
          )}

          {imageTopdownSrc && (
            <div id="detail-pane-topdown" class="detail-pane hidden w-full h-full flex flex-col items-center justify-center">
              <img
                src={imageTopdownSrc}
                alt={`${car.name} Top View`}
                class="max-h-48 w-auto object-contain drop-shadow-[0_16px_24px_rgba(0,0,0,0.8)]"
                style={topdownCropStyle}
              />
              <div class="w-2/3 h-1.5 bg-gradient-to-r from-transparent via-cyan-500/40 to-transparent blur-[2px] mt-4"></div>
            </div>
          )}

          {imageRefSrc && (
            <div id="detail-pane-ref" class="detail-pane hidden w-full h-full relative overflow-hidden rounded-lg">
              <img
                src={imageRefSrc}
                alt={`${car.name} Trackside Reference`}
                class="w-full h-full object-cover rounded-lg border border-racing-border/40"
              />
              <div class="absolute bottom-2 right-2 text-xs font-mono bg-black/70 px-2 py-1 rounded text-white/90">
                Official Trackside Reference
              </div>
            </div>
          )}
        </div>
      </div>

      <!-- Core Engine & Acceleration Specs -->
      <div class="rounded-xl border border-racing-border bg-racing-surface p-5">
        <h2 class="text-sm font-mono uppercase tracking-wider text-racing-muted mb-4">Core Specifications</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 font-mono text-xs">
          <div class="p-3 rounded-lg bg-racing-surface2/60 border border-racing-border/40">
            <span class="text-racing-muted text-[10px] uppercase block">Horsepower</span>
            <span class="text-xl font-bold text-white mt-1 block">{car.bhp} BHP</span>
            <span class="text-[10px] text-racing-cyan font-sans">{engineForceN} N engine force</span>
          </div>

          <div class="p-3 rounded-lg bg-racing-surface2/60 border border-racing-border/40">
            <span class="text-racing-muted text-[10px] uppercase block">Curb Weight</span>
            <span class="text-xl font-bold text-white mt-1 block">{car.weight_kg} kg</span>
            <span class="text-[10px] text-racing-muted font-sans">{weightToPower} kg/BHP</span>
          </div>

          <div class="p-3 rounded-lg bg-racing-surface2/60 border border-racing-border/40">
            <span class="text-racing-muted text-[10px] uppercase block">Power to Weight</span>
            <span class="text-xl font-bold text-racing-green mt-1 block">{powerToWeight}</span>
            <span class="text-[10px] text-racing-muted font-sans">BHP per tonne</span>
          </div>

          <div class="p-3 rounded-lg bg-racing-surface2/60 border border-racing-border/40">
            <span class="text-racing-muted text-[10px] uppercase block">Top Speed</span>
            <span class="text-xl font-bold text-racing-cyan mt-1 block">{car.top_speed_kmh} km/h</span>
            <span class="text-[10px] text-racing-muted font-sans">{physics.top_speed_mps.toFixed(1)} m/s sim limit</span>
          </div>

          <div class="p-3 rounded-lg bg-racing-surface2/60 border border-racing-border/40">
            <span class="text-racing-muted text-[10px] uppercase block">Acceleration</span>
            <span class="text-xl font-bold text-amber-400 mt-1 block">{car.accel_0_100 > 0 ? `${car.accel_0_100}s` : 'N/A'}</span>
            <span class="text-[10px] text-racing-muted font-sans">0–100 km/h sprint</span>
          </div>

          <div class="p-3 rounded-lg bg-racing-surface2/60 border border-racing-border/40">
            <span class="text-racing-muted text-[10px] uppercase block">Max Braking</span>
            <span class="text-xl font-bold text-orange-400 mt-1 block">{brakesKn} kN</span>
            <span class="text-[10px] text-racing-muted font-sans">{car.brakes_desc}</span>
          </div>
        </div>

        {car.engine_desc && (
          <div class="mt-4 pt-4 border-t border-racing-border/40 text-xs font-mono text-racing-muted flex items-center justify-between">
            <span>⚙️ Engine: <strong class="text-white font-normal">{car.engine_desc}</strong></span>
            {car.torque_nm > 0 && <span>Torque: <strong class="text-white font-normal">{car.torque_nm} N·m</strong></span>}
          </div>
        )}
      </div>

      <!-- Historical Bio & Sound -->
      <div class="rounded-xl border border-racing-border bg-racing-surface p-5 text-xs">
        <h2 class="font-mono uppercase tracking-wider text-racing-muted mb-2 text-[10px]">Vehicle Bio &amp; Audio</h2>
        <p class="text-racing-text italic leading-relaxed text-sm">"{car.history_bio}"</p>
        <div class="mt-3 pt-3 border-t border-racing-border/40 flex items-center justify-between text-racing-muted font-mono">
          <span>Audio Synthesizer: <strong class="text-white font-normal">{car.sound}</strong></span>
          <span>Category: <strong class="text-white font-normal">{car.category_name} ({car.category})</strong></span>
        </div>
      </div>
    </div>

    <!-- Right Column: Telemetry & In-Depth Technical Architecture (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <!-- Telemetry Rating Bars -->
      <div class="rounded-xl border border-racing-border bg-racing-surface p-5">
        <h2 class="text-sm font-mono uppercase tracking-wider text-racing-muted mb-3">Telemetry Performance Radar</h2>
        <div class="space-y-3 font-mono text-xs">
          <div>
            <div class="flex justify-between mb-1">
              <span class="text-slate-400">Speed</span>
              <span class="text-cyan-400 font-bold">{stats.speed}% ({car.top_speed_kmh} km/h)</span>
            </div>
            <div class="h-2 bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full bg-cyan-400 rounded-full" style={`width: ${stats.speed}%`}></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between mb-1">
              <span class="text-slate-400">Acceleration</span>
              <span class="text-amber-400 font-bold">{stats.acceleration}%</span>
            </div>
            <div class="h-2 bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full bg-amber-400 rounded-full" style={`width: ${stats.acceleration}%`}></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between mb-1">
              <span class="text-slate-400">Grip</span>
              <span class="text-emerald-400 font-bold">{stats.grip}%</span>
            </div>
            <div class="h-2 bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full bg-emerald-500 rounded-full" style={`width: ${stats.grip}%`}></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between mb-1">
              <span class="text-slate-400">Agility</span>
              <span class="text-fuchsia-400 font-bold">{stats.agility}%</span>
            </div>
            <div class="h-2 bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full bg-fuchsia-500 rounded-full" style={`width: ${stats.agility}%`}></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between mb-1">
              <span class="text-slate-400">Braking</span>
              <span class="text-orange-400 font-bold">{stats.braking}% ({brakesKn} kN)</span>
            </div>
            <div class="h-2 bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full bg-orange-500 rounded-full" style={`width: ${stats.braking}%`}></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between mb-1">
              <span class="text-slate-400">Downforce / Aero</span>
              <span class="text-white font-bold">{stats.aero}% (df {downforce.toFixed(2)} / cd {drag.toFixed(2)})</span>
            </div>
            <div class="h-2 bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full bg-white rounded-full" style={`width: ${stats.aero}%`}></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Chassis Platform Card & Plan Diagram -->
      <div class="rounded-xl border border-racing-border bg-racing-surface p-5">
        <div class="flex items-center justify-between mb-2">
          <h2 class="text-sm font-mono uppercase tracking-wider text-racing-muted">Chassis Platform</h2>
          <a
            href={`/technical/chassis#${platform.id}`}
            class="text-xs font-mono text-racing-cyan hover:underline flex items-center gap-1"
          >
            {platform.title} →
          </a>
        </div>
        <p class="text-xs text-racing-muted mb-3 font-mono">{platform.description}</p>

        <div class="bg-racing-bg/60 p-2 rounded-lg border border-racing-border/40 mb-4">
          <ChassisPlan platform={platform} />
        </div>

        <dl class="grid grid-cols-2 gap-2 text-xs font-mono">
          <div class="bg-racing-surface2/40 p-2 rounded">
            <dt class="text-[10px] text-racing-muted uppercase">Wheelbase</dt>
            <dd class="text-white font-bold">{platform.wheelbase_m.toFixed(2)} m</dd>
          </div>
          <div class="bg-racing-surface2/40 p-2 rounded">
            <dt class="text-[10px] text-racing-muted uppercase">Track Width</dt>
            <dd class="text-white font-bold">{platform.track_width_m.toFixed(2)} m</dd>
          </div>
          <div class="bg-racing-surface2/40 p-2 rounded">
            <dt class="text-[10px] text-racing-muted uppercase">Body Width</dt>
            <dd class="text-white font-bold">{platform.skeleton.body_width.toFixed(2)} m</dd>
          </div>
          <div class="bg-racing-surface2/40 p-2 rounded">
            <dt class="text-[10px] text-racing-muted uppercase">Total Length</dt>
            <dd class="text-white font-bold">{platform.total_length_m.toFixed(2)} m</dd>
          </div>
          <div class="bg-racing-surface2/40 p-2 rounded">
            <dt class="text-[10px] text-racing-muted uppercase">Weight Distribution</dt>
            <dd class="text-white font-bold">{frontWeightPct}% F / {rearWeightPct}% R</dd>
          </div>
          <div class="bg-racing-surface2/40 p-2 rounded">
            <dt class="text-[10px] text-racing-muted uppercase">Centre of Gravity</dt>
            <dd class="text-white font-bold">h={platform.cg_height_m.toFixed(2)} m</dd>
          </div>
        </dl>
      </div>

      <!-- Suspension Archetypes -->
      <div class="rounded-xl border border-racing-border bg-racing-surface p-5">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-sm font-mono uppercase tracking-wider text-racing-muted">Suspension</h2>
          <a href="/technical/suspension" class="text-xs font-mono text-racing-cyan hover:underline">Reference →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs font-mono">
          <div class="p-3 rounded-lg bg-racing-surface2/50 border border-racing-border/40">
            <span class="text-[10px] text-racing-muted uppercase block">Front Axle</span>
            <a href={`/technical/suspension#${frontSusp.archetype}`} class="text-racing-cyan font-bold block mt-1 hover:underline">
              {ARCHETYPE_LABEL[frontSusp.archetype] ?? frontSusp.archetype}
            </a>
            <div class="mt-2 space-y-0.5 text-[11px] text-racing-muted">
              <div>Spring: <strong class="text-white font-normal">{Math.round(frontSusp.spring_rate / 1000)} kN/m</strong></div>
              <div>Damp: <strong class="text-white font-normal">{frontSusp.bump_damping_ratio.toFixed(2)} / {frontSusp.rebound_damping_ratio.toFixed(2)}</strong></div>
              <div>Travel: <strong class="text-white font-normal">{Math.round(frontSusp.max_bump_travel * 1000)} / {Math.round(frontSusp.max_rebound_travel * 1000)} mm</strong></div>
              <div>Camber: <strong class="text-white font-normal">{deg(frontSusp.static_camber).toFixed(1)}°</strong> (recov {Math.round(frontSusp.camber_recovery * 100)}%)</div>
            </div>
          </div>

          <div class="p-3 rounded-lg bg-racing-surface2/50 border border-racing-border/40">
            <span class="text-[10px] text-racing-muted uppercase block">Rear Axle</span>
            <a href={`/technical/suspension#${rearSusp.archetype}`} class="text-racing-cyan font-bold block mt-1 hover:underline">
              {ARCHETYPE_LABEL[rearSusp.archetype] ?? rearSusp.archetype}
            </a>
            <div class="mt-2 space-y-0.5 text-[11px] text-racing-muted">
              <div>Spring: <strong class="text-white font-normal">{Math.round(rearSusp.spring_rate / 1000)} kN/m</strong></div>
              <div>Damp: <strong class="text-white font-normal">{rearSusp.bump_damping_ratio.toFixed(2)} / {rearSusp.rebound_damping_ratio.toFixed(2)}</strong></div>
              <div>Travel: <strong class="text-white font-normal">{Math.round(rearSusp.max_bump_travel * 1000)} / {Math.round(rearSusp.max_rebound_travel * 1000)} mm</strong></div>
              <div>Camber: <strong class="text-white font-normal">{deg(rearSusp.static_camber).toFixed(1)}°</strong> (recov {Math.round(rearSusp.camber_recovery * 100)}%)</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Drivetrain, Differentials & Tyres -->
      <div class="rounded-xl border border-racing-border bg-racing-surface p-5">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-sm font-mono uppercase tracking-wider text-racing-muted">Drivetrain &amp; Tyres</h2>
          <a href="/technical/drivetrain" class="text-xs font-mono text-racing-cyan hover:underline">Reference →</a>
        </div>
        <div class="space-y-3 text-xs font-mono">
          <div class="flex items-center justify-between p-2 rounded bg-racing-surface2/40">
            <span class="text-racing-muted">Drive Split</span>
            <span class="text-white font-bold">{driveSplit}</span>
          </div>

          <div class="flex items-center justify-between p-2 rounded bg-racing-surface2/40">
            <span class="text-racing-muted">Engine Placement</span>
            <a href={`/technical/drivetrain#engine-placement`} class="text-racing-cyan font-bold hover:underline">
              {PLACEMENT_LABEL[enginePlacement] ?? enginePlacement}
            </a>
          </div>

          <div class="p-2 rounded bg-racing-surface2/40">
            <div class="flex justify-between items-center">
              <span class="text-racing-muted">Differentials</span>
              <a href="/technical/drivetrain#differentials" class="text-[10px] text-racing-cyan hover:underline">View details</a>
            </div>
            <div class="mt-1 text-[11px] text-white">
              <div>Front: <span class="text-racing-muted">{differentialLabel(frontDiff)}</span></div>
              <div>Rear: <span class="text-racing-muted">{differentialLabel(rearDiff)}</span></div>
            </div>
          </div>

          <div class="flex items-center justify-between p-2 rounded bg-racing-surface2/40">
            <span class="text-racing-muted">Fitted Compound</span>
            <a href={`/technical/tyres#compounds`} class="font-bold flex items-center gap-1.5 hover:underline text-white">
              <span class="inline-block px-1.5 py-0.5 rounded text-[10px] text-black font-bold" style={`background:${compoundColor}`}>
                {compoundBadge}
              </span>
              <span>{compoundName}</span>
            </a>
          </div>

          <div class="p-2 rounded bg-racing-surface2/40 text-[11px]">
            <div class="text-racing-muted mb-1">Wheel Dimensions:</div>
            <div class="text-white">Front: r={wheelFront.tire_radius.toFixed(2)}m, w={wheelFront.tire_width.toFixed(2)}m (I={wheelFront.rotational_inertia.toFixed(1)} kg·m²)</div>
            <div class="text-white">Rear: r={wheelRear.tire_radius.toFixed(2)}m, w={wheelRear.tire_width.toFixed(2)}m (I={wheelRear.rotational_inertia.toFixed(1)} kg·m²)</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  function initDetailToggles() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.detail-view-btn');
    const panes = {
      lateral: document.getElementById('detail-pane-lateral'),
      topdown: document.getElementById('detail-pane-topdown'),
      ref: document.getElementById('detail-pane-ref'),
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.target as 'lateral' | 'topdown' | 'ref';
        if (!target) return;

        buttons.forEach((b) => {
          b.classList.remove('text-white', 'bg-racing-blue', 'font-semibold');
          b.classList.add('text-racing-muted');
        });
        btn.classList.add('text-white', 'bg-racing-blue', 'font-semibold');
        btn.classList.remove('text-racing-muted');

        Object.entries(panes).forEach(([key, el]) => {
          if (!el) return;
          if (key === target) {
            el.classList.remove('hidden');
            el.classList.add('flex');
          } else {
            el.classList.add('hidden');
            el.classList.remove('flex');
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDetailToggles);
  } else {
    initDetailToggles();
  }
</script>
