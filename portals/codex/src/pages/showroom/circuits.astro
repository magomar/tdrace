---
import Layout from '../../layouts/Layout.astro';
import CircuitCard from '../../components/CircuitCard.astro';
import { categoryLabel, getCircuits, getModules, moduleLabel } from '../../lib/codex';

const circuitsData = await getCircuits();
const modules = [
  { id: 'all', label: 'All modules' },
  ...(await getModules()).map((m) => ({ id: m.id, label: moduleLabel(m.id) })),
];
---

<Layout title="Circuit Directory" description={`Explore ${circuitsData.length} official circuits with length, width, surfaces, joker laps and pit lanes.`}>
  <div class="py-6 border-b border-racing-border">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl font-extrabold text-white tracking-tight">Circuit Directory</h1>
        <p class="text-sm text-racing-muted font-mono mt-1">
          {circuitsData.length} vector tracks with surface compositions, Joker Laps, and jump ramps.
        </p>
      </div>

      <!-- Search Input -->
      <div class="w-full md:w-72">
        <input
          type="text"
          id="circuit-search"
          placeholder="Search by circuit category (e.g. offroad, gt, rally)..."
          class="w-full px-4 py-2 bg-racing-surface border border-racing-border rounded-lg text-xs font-mono text-white placeholder-racing-muted focus:outline-none focus:border-racing-blue"
        />
      </div>
    </div>

    <!-- Module Filters -->
    <div class="flex flex-wrap gap-2 mt-6">
      {modules.map((m, idx) => (
        <button
          type="button"
          class={`module-btn px-3 py-1.5 rounded-lg text-xs font-mono transition-all ${
            idx === 0
              ? 'active bg-racing-blue text-white font-bold shadow-lg shadow-racing-blue/20'
              : 'bg-racing-surface border border-racing-border text-racing-muted hover:text-white hover:bg-racing-surface2'
          }`}
          data-module={m.id}
        >
          {m.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Circuits Grid -->
  <div id="circuits-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 py-8">
    {circuitsData.map((c) => (
      <div
        class="circuit-item"
        data-module={c.module}
        data-search={`${c.name} ${c.tag} ${c.category_label} ${c.country_name ?? ''} ${c.surfaces.map((s) => s.surface).join(' ')} ${moduleLabel(c.module)} ${categoryLabel(c.category)}`.toLowerCase()}
      >
        <CircuitCard circuit={c} />
      </div>
    ))}

    <div id="no-circuits-notice" class="hidden col-span-full py-16 text-center">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-racing-surface border border-racing-border text-2xl mb-3">
        🏁
      </div>
      <h3 class="text-lg font-bold text-white font-mono">No Circuits Found</h3>
      <p class="text-xs text-racing-muted font-mono mt-1" id="no-circuits-msg">
        No circuits currently match the selected module or search query.
      </p>
    </div>
  </div>
</Layout>

<script>
  function initCircuitFilters() {
    const filterBtns = document.querySelectorAll('.module-btn');
    const searchInput = document.getElementById('circuit-search') as HTMLInputElement;
    const items = document.querySelectorAll('.circuit-item');
    const noCircuitsNotice = document.getElementById('no-circuits-notice');
    const noCircuitsMsg = document.getElementById('no-circuits-msg');

    let currentModule = 'all';
    let searchQuery = '';

    function applyFilter() {
      let visibleCount = 0;
      items.forEach((el) => {
        const item = el as HTMLElement;
        const itemModule = item.dataset.module || '';
        const itemSearch = item.dataset.search || '';

        const matchesModule = currentModule === 'all' || itemModule === currentModule;
        const matchesSearch = searchQuery === '' || itemSearch.includes(searchQuery.toLowerCase());

        if (matchesModule && matchesSearch) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (noCircuitsNotice) {
        if (visibleCount === 0) {
          noCircuitsNotice.classList.remove('hidden');
          if (noCircuitsMsg) noCircuitsMsg.textContent = 'No circuits currently match the selected module or search query.';
        } else {
          noCircuitsNotice.classList.add('hidden');
        }
      }
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        filterBtns.forEach((b) => {
          b.classList.remove('active', 'bg-racing-blue', 'text-white', 'font-bold', 'shadow-lg', 'shadow-racing-blue/20');
          b.classList.add('bg-racing-surface', 'border', 'border-racing-border', 'text-racing-muted');
        });
        target.classList.add('active', 'bg-racing-blue', 'text-white', 'font-bold', 'shadow-lg', 'shadow-racing-blue/20');
        target.classList.remove('text-racing-muted', 'bg-racing-surface');

        currentModule = target.dataset.module || 'all';
        applyFilter();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value.trim();
        applyFilter();
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCircuitFilters);
  } else {
    initCircuitFilters();
  }
</script>
