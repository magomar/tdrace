---
import Layout from '../../layouts/Layout.astro';
import { getRacingModel, moduleLabel } from '../../lib/codex';

const racing = await getRacingModel();
const academy = racing.academy;
const curriculum = academy.curriculum;
const licenceGrades = academy.licence_grades;

const GRADE_STYLES: Record<string, { bg: string; text: string; border: string }> = {
  ClassD: { bg: 'bg-slate-500/15', text: 'text-slate-300', border: 'border-slate-500/30' },
  ClassC: { bg: 'bg-emerald-500/15', text: 'text-emerald-400', border: 'border-emerald-500/30' },
  ClassB: { bg: 'bg-amber-500/15', text: 'text-amber-400', border: 'border-amber-500/30' },
  ClassA: { bg: 'bg-cyan-500/15', text: 'text-cyan-400', border: 'border-cyan-500/30' },
  ClassS: { bg: 'bg-purple-500/15', text: 'text-purple-300', border: 'border-purple-500/30' },
};
---

<Layout
  title="Racing Academy & Licences — TDRace Codex"
  description="Master vehicle dynamics, earn medal bounties in four curriculum lessons, and advance through Class D to Class S motorsport licence grades."
>
  <div class="py-6 border-b border-racing-border max-w-5xl">
    <p class="text-xs font-mono text-racing-cyan"><a href="/racing" class="hover:underline">Racing</a> / Academy</p>
    <h1 class="text-3xl font-extrabold text-white tracking-tight mt-1">Racing Academy &amp; Driver Licences</h1>
    <p class="text-sm text-racing-muted mt-3 leading-relaxed max-w-3xl">
      The TDRace Academy transitions aspiring drivers from novice racers to elite competitors. Complete four rigorous
      curriculum lessons to earn credit bounties, acquire XP prestige, and qualify for higher-tier motorsport licence grades.
    </p>

    <!-- Quick Telemetry Stats -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6">
      <div class="p-3 rounded-lg border border-racing-border bg-racing-surface">
        <div class="text-[11px] font-mono text-racing-muted uppercase">Curriculum Lessons</div>
        <div class="text-2xl font-bold text-white mt-0.5">{curriculum.length}</div>
        <div class="text-[11px] text-racing-cyan font-mono mt-0.5">Foundational tests</div>
      </div>
      <div class="p-3 rounded-lg border border-racing-border bg-racing-surface">
        <div class="text-[11px] font-mono text-racing-muted uppercase">Licence Grades</div>
        <div class="text-2xl font-bold text-white mt-0.5">{licenceGrades.length}</div>
        <div class="text-[11px] text-racing-muted font-mono mt-0.5">Class D to Class S</div>
      </div>
      <div class="p-3 rounded-lg border border-racing-border bg-racing-surface">
        <div class="text-[11px] font-mono text-racing-muted uppercase">Max Impact Impulse</div>
        <div class="text-2xl font-bold text-rose-400 mt-0.5">{academy.max_permissible_impulse} N&middot;s</div>
        <div class="text-[11px] text-racing-muted font-mono mt-0.5">Clean attempt limit</div>
      </div>
      <div class="p-3 rounded-lg border border-racing-border bg-racing-surface">
        <div class="text-[11px] font-mono text-racing-muted uppercase">Off-Track Limit</div>
        <div class="text-2xl font-bold text-amber-400 mt-0.5">{academy.max_permissible_off_track_sec.toFixed(1)}s</div>
        <div class="text-[11px] text-racing-muted font-mono mt-0.5">Track limits tolerance</div>
      </div>
    </div>
  </div>

  <!-- Curriculum Lessons -->
  <section class="py-8 max-w-5xl">
    <div class="mb-6">
      <h2 class="text-xl font-bold text-white tracking-tight">Academy Curriculum Lessons</h2>
      <p class="text-xs text-racing-muted font-mono mt-1">Four progressive tests verifying apex precision, threshold braking, surface control, and racecraft.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {curriculum.map((lesson) => (
        <div class="rounded-xl border border-racing-border bg-racing-surface p-5 flex flex-col justify-between shadow-sm">
          <div>
            <div class="flex items-center justify-between gap-2 border-b border-racing-border/60 pb-3">
              <span class="text-[10px] font-mono px-2 py-0.5 rounded-full border bg-racing-cyan/15 text-racing-cyan border-racing-cyan/30">
                Lesson 0{lesson.index}
              </span>
              <span class="text-xs font-mono text-racing-muted">+{lesson.base_xp_reward} XP Base</span>
            </div>

            <h3 class="text-lg font-bold text-white tracking-tight mt-3">{lesson.title}</h3>
            <p class="text-xs text-racing-muted mt-1.5 leading-relaxed min-h-[36px]">
              {lesson.description}
            </p>

            <!-- Test Equipment -->
            <div class="mt-4 pt-3 border-t border-racing-border/40 grid grid-cols-2 gap-2 text-xs font-mono">
              <div class="p-2 rounded bg-racing-card border border-racing-border/60">
                <div class="text-[10px] text-racing-muted uppercase">Circuit</div>
                <a href={`/showroom/circuits#${lesson.track_slug}`} class="text-white hover:text-racing-cyan transition-colors truncate block mt-0.5">
                  {lesson.track_slug.replace(/_/g, ' ')}
                </a>
              </div>
              <div class="p-2 rounded bg-racing-card border border-racing-border/60">
                <div class="text-[10px] text-racing-muted uppercase">Vehicle</div>
                <a href={`/showroom/cars#${lesson.car_slug}`} class="text-white hover:text-racing-cyan transition-colors truncate block mt-0.5">
                  {lesson.car_slug.replace(/_/g, ' ')}
                </a>
              </div>
            </div>

            <!-- Target Times & Bounties -->
            <div class="mt-4 space-y-2">
              <h4 class="text-[10px] font-mono text-racing-cyan uppercase tracking-wider">Medal Targets &amp; Bounties</h4>
              <div class="grid grid-cols-3 gap-2 text-xs font-mono text-center">
                <!-- Gold -->
                <div class="p-2 rounded-lg border border-amber-500/30 bg-amber-500/10">
                  <div class="text-[10px] text-amber-300 font-bold uppercase">🥇 Gold</div>
                  <div class="text-sm font-bold text-white mt-1">{lesson.gold_time_sec.toFixed(2)}s</div>
                  <div class="text-[10px] text-amber-400 mt-0.5">+{lesson.gold_credit_bounty} Cr</div>
                </div>

                <!-- Silver -->
                <div class="p-2 rounded-lg border border-slate-400/30 bg-slate-400/10">
                  <div class="text-[10px] text-slate-300 font-bold uppercase">🥈 Silver</div>
                  <div class="text-sm font-bold text-white mt-1">{lesson.silver_time_sec.toFixed(2)}s</div>
                  <div class="text-[10px] text-slate-300 mt-0.5">+{lesson.silver_credit_bounty} Cr</div>
                </div>

                <!-- Bronze -->
                <div class="p-2 rounded-lg border border-amber-700/30 bg-amber-700/10">
                  <div class="text-[10px] text-amber-500 font-bold uppercase">🥉 Bronze</div>
                  <div class="text-sm font-bold text-white mt-1">{lesson.bronze_time_sec.toFixed(2)}s</div>
                  <div class="text-[10px] text-amber-500 mt-0.5">+{lesson.bronze_credit_bounty} Cr</div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-racing-border/60 flex items-center justify-between text-[11px] font-mono text-racing-muted">
            <span>Cumulative Bounty: <strong class="text-emerald-400">{(lesson.gold_credit_bounty + lesson.silver_credit_bounty + lesson.bronze_credit_bounty).toLocaleString('en-US')} Cr</strong></span>
            <span class="text-cyan-400">Licence Qualifying</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Clean Lap Validation Rules -->
  <section class="py-8 border-t border-racing-border max-w-5xl">
    <div class="rounded-xl border border-rose-500/30 bg-rose-500/5 p-6">
      <div class="flex items-center gap-2 border-b border-rose-500/20 pb-3">
        <span class="text-base">⚠️</span>
        <h2 class="text-lg font-bold text-white tracking-tight">Attempt Validation &amp; Invalidation Rules</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4 text-xs leading-relaxed text-slate-300">
        <div>
          <h3 class="text-xs font-mono text-rose-300 uppercase tracking-wider mb-1">
            Impact Impulse Threshold (&le; {academy.max_permissible_impulse} N&middot;s)
          </h3>
          <p>
            The telemetry system continuously measures total collision impulse during the attempt. Minor contact with rubber cones
            or plastic tyre markers is absorbed. However, any collision exceeding <strong class="text-white">{academy.max_permissible_impulse} N&middot;s</strong>
            (such as striking a concrete retaining wall, metal Armco barrier, or tire wall at speed) results in an immediate
            <strong class="text-rose-400 font-mono">ATTEMPT FAILED: EXCESSIVE COLLISION IMPULSE</strong> disqualification.
          </p>
        </div>

        <div>
          <h3 class="text-xs font-mono text-amber-300 uppercase tracking-wider mb-1">
            Track Limits Tolerance (&le; {academy.max_permissible_off_track_sec.toFixed(1)} Seconds)
          </h3>
          <p>
            Cutting corners over the inner verge or extending wide beyond outer painted track boundaries incurs a real-time off-track clock.
            If the vehicle remains outside racing bounds for more than <strong class="text-white">{academy.max_permissible_off_track_sec.toFixed(1)} seconds</strong>,
            the timing gate aborts the run with <strong class="text-amber-400 font-mono">ATTEMPT INVALIDATED: TRACK LIMITS EXCEEDED</strong>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Motorsport Licence Grades -->
  <section class="py-8 border-t border-racing-border max-w-5xl">
    <div class="mb-6">
      <h2 class="text-xl font-bold text-white tracking-tight">Motorsport Licence Grades</h2>
      <p class="text-xs text-racing-muted font-mono mt-1">Accredited racing credentials governing entry into championship categories.</p>
    </div>

    <div class="space-y-4">
      {licenceGrades.map((lic) => {
        const style = GRADE_STYLES[lic.grade] ?? GRADE_STYLES.ClassD;
        return (
          <div class="rounded-xl border border-racing-border bg-racing-surface p-5 flex flex-col md:flex-row md:items-center justify-between gap-4 shadow-sm">
            <div class="flex items-start gap-4">
              <span class={`text-xs font-mono font-bold px-3 py-1 rounded-lg border ${style.bg} ${style.text} ${style.border} shrink-0`}>
                {lic.badge}
              </span>
              <div>
                <h3 class="text-base font-bold text-white">{lic.title}</h3>
                <p class="text-xs text-racing-muted mt-1 leading-relaxed max-w-2xl">
                  {lic.description}
                </p>
              </div>
            </div>

            <div class="flex flex-col md:items-end shrink-0 text-xs font-mono">
              <span class="text-[10px] text-racing-muted uppercase">Authorizes</span>
              <div class="flex flex-wrap gap-1 mt-1">
                {lic.required_for.map((modId) => (
                  <span class="px-2 py-0.5 rounded bg-racing-card border border-racing-border text-racing-cyan text-[11px]">
                    {moduleLabel(modId)}
                  </span>
                ))}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Layout>
