{
  "name": "tdrace-portals",
  "private": true,
  "workspaces": [
    "option-a-starlight",
    "option-b-showroom"
  ],
  "scripts": {
    "dev:starlight": "cd option-a-starlight && bun run dev -- --port 4321",
    "dev:showroom": "cd option-b-showroom && bun run dev -- --port 4322",
    "build:starlight": "cd option-a-starlight && bun run build",
    "build:showroom": "cd option-b-showroom && bun run build",
    "build:all": "bun run build:starlight && bun run build:showroom",
    "build": "bun run build:starlight && bun run build:showroom",
    "ingest": "python3 ../scripts/generate_asset_data.py",
    "verify:okf": "python3 ../scripts/verify_okf.py"
  }
}
