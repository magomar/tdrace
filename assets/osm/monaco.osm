  <tag k="name" v="Via Alpina"/>
  <tag k="network" v="iwn"/>
  <tag k="note" v="Since 2024, the Via Alpina is a consolidation of the Via Alpina trail system (red, purple, yellow, green, and blue) into one trail."/>
