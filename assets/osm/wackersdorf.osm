  <tag k="description" v="Rundwanderweg Schwarzenfeld &gt; Schwandorf &gt; Burglengenfeld &gt; Nittenau &gt; Bodenwöhr &gt; Neuenschwand &gt; Schwarzenfeld. Die Tour besteht aus 5-6 Tagesetappen an mehreren typischen Oberpfälzer Brauereien vorbei. Es wird auch Wandern ohne Gepäck angeboten."/>
  <tag k="distance" v="95"/>
  <tag k="name" v="Rundwanderweg Scharzenfeld"/>
  <tag k="network" v="rwn"/>
  <tag k="note" v="completed by stone005; Umleitungsstrecken d. LRA bereits vollzogen"/>
  <tag k="operator" v="aufgelöst"/>
  <tag k="osmc:symbol" v="yellow:white:yellow_rectangle"/>
  <tag k="ref" v="Bier"/>
  <tag k="roundtrip" v="yes"/>
  <tag k="route" v="hiking"/>
  <tag k="symbol" v="Oranges Quadrat auf weißem rechteckigen Grund;tlw. Anzeige der Richtung des Rundwegs."/>
  <tag k="type" v="route"/>
  <tag k="website" v="https://www.oberpfaelzer-seenland.de/"/>
  <tag k="wiki:symbol" v="Wanderwegsymbol_Bierwanderung_(Oberpfälzer_Wald).PNG"/>
 </relation>
