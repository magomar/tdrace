  <tag k="alt_name:en" v="St. Olav's Way"/>
  <tag k="description" v="The St. Olav's Path starts in Selånger outside Sundsvall and ends at Nidaros Cathedral in Trondheim."/>
  <tag k="description2" v="It follows the road King Olav Haraldsson travelled in the summer of 1030 when he came back from Novgorod in Russia to Christianize Norway and reclaim the Norwegian throne."/>
  <tag k="distance" v="564"/>
  <tag k="name" v="St. Olavsleden"/>
