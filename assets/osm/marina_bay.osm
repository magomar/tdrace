 <node id="1766486405" visible="true" version="14" changeset="175136549" timestamp="2025-11-26T04:09:32Z" user="confusedbuffalo" uid="242345" lat="1.2951307" lon="103.8534677">
  <tag k="addr:city" v="Singapore"/>
  <tag k="addr:housenumber" v="1"/>
  <tag k="addr:postcode" v="189673"/>
  <tag k="addr:street" v="Beach Road"/>
  <tag k="amenity" v="bar"/>
  <tag k="check_date" v="2025-03-28"/>
  <tag k="contact:cntraveler" v="https://cntraveler.com/bars/long-bar"/>
  <tag k="contact:email" v="dining.singapore@raffles.com"/>
  <tag k="contact:phone" v="+65 6412 1816"/>
  <tag k="contact:tripadvisor" v="https://tripadvisor.com/Attraction_Review-g294265-d446993-Reviews-Long_Bar-Singapore.html"/>
  <tag k="contact:yelp" v="https://yelp.com/biz/long-bar-singapore-2"/>
  <tag k="description" v="The Long Bar at Raffles Hotel in Singapore is renowned as the birthplace of the Singapore Sling cocktail, offering colonial charm and a vibrant atmosphere. Guests can enjoy signature cocktails and traditional snacks, like monkey nuts, in a relaxed setting"/>
  <tag k="description:en" v="The Long Bar at Raffles Hotel in Singapore is renowned as the birthplace of the Singapore Sling cocktail, offering colonial charm and a vibrant atmosphere. Guests can enjoy signature cocktails and traditional snacks, like monkey nuts, in a relaxed setting"/>
  <tag k="description:ja" v="ラッフルズホテルのロングバーは、シンガポールスリングカクテルの発祥地として知られ、コロニアルな魅力と活気ある雰囲気を提供しています。ゲストは、リラックスした雰囲気の中で、シグネチャーカクテルや伝統的なスナック（ピーナッツなど）を楽しむことができます。"/>
  <tag k="description:ko" v="싱가포르 라플스 호텔의 롱 바는 싱가포르 슬링 칵테일의 발상지로 유명하며, 식민지 시대의 매력과 활기찬 분위기를 제공합니다. 손님들은 편안한 환경에서 시그니처 칵테일과 전통 스낵인 땅콩을 즐길 수 있습니다."/>
  <tag k="description:ms" v="Long Bar di Raffles Hotel, Singapura, terkenal sebagai tempat kelahiran koktel Singapore Sling, dengan daya tarikan kolonial dan suasana meriah. Tetamu boleh menikmati koktel khas dan snek tradisional seperti kacang monyet dalam suasana santai."/>
  <tag k="description:zh" v="新加坡拉弗尔酒店的长吧以新加坡斯林鸡尾酒的发源地而闻名，融合了殖民魅力和生动的氛围。客人可以在轻松的环境中享用招牌鸡尾酒和传统小吃，如猴子坚果。"/>
  <tag k="drink:cocktail" v="served"/>
  <tag k="drink:singapore_sling" v="served"/>
  <tag k="image" v="https://commons.wikimedia.org/wiki/Category:Long_Bar#/media/File:Wikimania_2023-Raffles_Hotel-Long_Bar-Singapore_Sling-185503.jpg"/>
  <tag k="name" v="Long Bar"/>
  <tag k="opening_hours" v="Su-Th 11:00-00:30; Fr-Sa 11:00-01:30"/>
  <tag k="reservation" v="no"/>
  <tag k="tourism" v="attraction"/>
  <tag k="website" v="https://raffles.com/singapore/dining/long-bar"/>
  <tag k="wheelchair" v="yes"/>
  <tag k="wikimedia_commons" v="Category:Long_Bar"/>
 </node>
