 <node id="6419140319" visible="true" version="2" changeset="143898529" timestamp="2023-11-11T12:52:46Z" user="Mith252" uid="3767835" lat="1.2814755" lon="103.8590123"/>
 <node id="6425334446" visible="true" version="1" changeset="69520488" timestamp="2019-04-24T10:33:11Z" user="pyramid" uid="468895" lat="1.2969632" lon="103.8499164">
  <tag k="description" v="The venerable Bodhi Tree was conserved during the site’s development – it was protected in place during construction and integrated into the Campus Green landscape."/>
  <tag k="name" v="Bodhi Tree (Ficus religiosa)"/>
  <tag k="natural" v="tree"/>
 </node>
 <node id="6425338734" visible="true" version="1" changeset="69520488" timestamp="2019-04-24T10:33:23Z" user="pyramid" uid="468895" lat="1.2957616" lon="103.8519431">
  <tag k="description" v="Red Flame (Delonix regia) is a fast-growing tree with large red flowers. The fruit is a long flattened green pid which turns black when ripe."/>
  <tag k="name" v="Red Flame (Delonix regia)"/>
  <tag k="natural" v="tree"/>
 </node>
 <node id="6425338735" visible="true" version="1" changeset="69520488" timestamp="2019-04-24T10:33:26Z" user="pyramid" uid="468895" lat="1.2952707" lon="103.8532760">
  <tag k="description" v="Traveller’s Palm is a symbol of the Raffles Hotel. It is believed that in the past, the Traveller’s Palm was a welcome sight to thirsty travellers, who could drink the rainwater collected in the base of the leaves."/>
  <tag k="name" v="Traveller’s Palm (Ravenala madagascariensis)"/>
  <tag k="natural" v="tree"/>
 </node>
 <node id="6425338736" visible="true" version="1" changeset="69520488" timestamp="2019-04-24T10:33:28Z" user="pyramid" uid="468895" lat="1.2924011" lon="103.8527687">
  <tag k="description" v="Golden Shower Tree (Cassia fistula), which produces clusters of long, hanging, bright yellow and fragrant flowers. Nearly all parts of the tree have medicinal properties."/>
  <tag k="name" v="Golden Shower Tree (Cassia fistula)"/>
  <tag k="natural" v="tree"/>
 </node>
 <node id="6425338737" visible="true" version="2" changeset="69550515" timestamp="2019-04-25T06:27:47Z" user="pyramid" uid="468895" lat="1.2919670" lon="103.8522701">
  <tag k="name" v="Sealing Wax Palm (Cyrtostachys renda)"/>
  <tag k="natural" v="tree"/>
 </node>
 <node id="6425340000" visible="true" version="1" changeset="69520488" timestamp="2019-04-24T10:33:12Z" user="pyramid" uid="468895" lat="1.2967046" lon="103.8501438">
  <tag k="description" v="Here, you can find a majestic Rain Tree estimated to be over 80 years old! It was conserved and transplanted into this location during the development of SMU. At the time of transplanting, it stood 21 m in height,  had a 25 m canopy, and weighted 37 t."/>
  <tag k="name" v="Rain Tree (Samanea saman)"/>
  <tag k="natural" v="tree"/>
 </node>
 <node id="6425340001" visible="true" version="1" changeset="69520488" timestamp="2019-04-24T10:33:14Z" user="pyramid" uid="468895" lat="1.2960929" lon="103.8491608">
  <tag k="description" v="The tree is native to tropical Africa and was introduced to Singapore in the late 1970s and can grow up to 60 m in its native environment."/>
  <tag k="name" v="East African Mahogany (Khaya nyasica)"/>
  <tag k="natural" v="tree"/>
 </node>
 <node id="6425340002" visible="true" version="1" changeset="69520488" timestamp="2019-04-24T10:33:16Z" user="pyramid" uid="468895" lat="1.2952122" lon="103.8499878">
  <tag k="name" v="Star Apple (Chrysophyllum cainito)"/>
  <tag k="natural" v="tree"/>
 </node>
 <node id="6425341305" visible="true" version="1" changeset="69520488" timestamp="2019-04-24T10:33:15Z" user="pyramid" uid="468895" lat="1.2957044" lon="103.8501071">
  <tag k="description" v="This popular ornamental tree was first introduced to Singapore in 1982 and is fast growing, requiring minimal maintenance. Its attractive yellow flowers attract butterflies, bees and birds."/>
  <tag k="name" v="Golden Penda (Xanthostemon chrysanthus)"/>
  <tag k="natural" v="tree"/>
 </node>
 <node id="6425341306" visible="true" version="1" changeset="69520488" timestamp="2019-04-24T10:33:17Z" user="pyramid" uid="468895" lat="1.2947856" lon="103.8506868">
  <tag k="description" v="Along Queen Street are beautiful Trumpet Trees that bloom in pink, mauve or white. Trumpet Trees can grow up to more than 30 m tall and  usually flower in April and August, after a prolonged dry spell."/>
  <tag k="name" v="Trumpet Tree (Tabebuia rosea)"/>
  <tag k="natural" v="tree"/>
 </node>
 <node id="6425341308" visible="true" version="1" changeset="69520488" timestamp="2019-04-24T10:33:20Z" user="pyramid" uid="468895" lat="1.2960275" lon="103.8514632">
  <tag k="description" v="The Angsana is widely distributed in Southeast Asia, where it grows naturally on flat coastal plains behind mangrove swamps or along inland rivers in forests where the dry season is not pronounced."/>
  <tag k="name" v="Angsana"/>
  <tag k="natural" v="tree"/>
 </node>
 <node id="6425341309" visible="true" version="1" changeset="69520488" timestamp="2019-04-24T10:33:24Z" user="pyramid" uid="468895" lat="1.2956699" lon="103.8518335">
  <tag k="description" v="Diospyros buxifolia, a native evergreen tree that can grow up to 30 m tall."/>
  <tag k="name" v="Diospyros buxifolia"/>
  <tag k="natural" v="tree"/>
 </node>
 <node id="6425341311" visible="true" version="1" changeset="69520488" timestamp="2019-04-24T10:33:30Z" user="pyramid" uid="468895" lat="1.2921945" lon="103.8513951">
  <tag k="description" v="These trees produce white, showy flowers and fruits that are eaten by bats and birds."/>
  <tag k="name" v="Sea Apple (Syzygium grande)"/>
  <tag k="natural" v="tree"/>
 </node>
 <node id="6425341390" visible="true" version="3" changeset="127475636" timestamp="2022-10-13T15:03:31Z" user="kmpoppe (@ Mapillary Update)" uid="14309561" lat="1.2963438" lon="103.8491707">
  <tag k="description" v="Admire the interesting aerial roots that descend from the tree. This tree has been endorsed as a Heritage Tree, as it can be seen in photographs taken in 1955 - evidence that it is more than 60 years old!"/>
  <tag k="image" v="https://images.mapillary.com/-kj_vrobnmAyYmRsH286_Q/thumb-2048.jpg"/>
  <tag k="leaf_cycle" v="evergreen"/>
  <tag k="leaf_type" v="broadleaved"/>
  <tag k="mapillary" v="311897207215938"/>
  <tag k="name" v="Indian Rubber Tree (Ficus elastica)"/>
  <tag k="natural" v="tree"/>
 </node>
 <node id="6425341391" visible="true" version="2" changeset="147922355" timestamp="2024-02-26T09:10:58Z" user="vt100" uid="15110" lat="1.2949066" lon="103.8496544">
  <tag k="name" v="Star Apple (Chrysophyllum cainito)"/>
  <tag k="natural" v="tree"/>
 </node>
 <node id="6425341393" visible="true" version="1" changeset="69520488" timestamp="2019-04-24T10:33:20Z" user="pyramid" uid="468895" lat="1.2964704" lon="103.8512962">
  <tag k="name" v="Yellow Rain Tree (Samanea saman ‘Yellow’)"/>
  <tag k="natural" v="tree"/>
 </node>
 <node id="6425341394" visible="true" version="1" changeset="69520488" timestamp="2019-04-24T10:33:22Z" user="pyramid" uid="468895" lat="1.2957191" lon="103.8520276">
  <tag k="description" v="Common Red-stem Fig (Ficus variegata) has fruits (figs) that are borne in clusters along the trunk and main branches."/>
  <tag k="name" v="Common Red-stem Fig (Ficus variegata)"/>
  <tag k="natural" v="tree"/>
 </node>
 <node id="6425341395" visible="true" version="1" changeset="69520488" timestamp="2019-04-24T10:33:25Z" user="pyramid" uid="468895" lat="1.2952617" lon="103.8519166">
  <tag k="description" v="Traditionally, different parts of this tree are used for medicinal purposes."/>
  <tag k="name" v="Creamy Yellow Frangipanis (Plumeria rubra)"/>
  <tag k="natural" v="tree"/>
 </node>
 <node id="6425341396" visible="true" version="1" changeset="69520488" timestamp="2019-04-24T10:33:27Z" user="pyramid" uid="468895" lat="1.2936282" lon="103.8547241">
  <tag k="description" v="Native to Singapore and other parts of the region, this evergreen tree can grow to more than 20 m tall. The flesh of the mature seeds is used to make belinjau crackers, a type of Indonesian snack. Roots are used in medicine aginst poisoning and malaria."/>
