  <tag k="description:de" v="2023 spendete der DAMC 05 zu Ehren ihres Mitgliedes Kurt Bosch neue Straßenschilder aus Emaille. Bosch war langjähriger  Rennleiter und Sportleiter des ADAC."/>
  <tag k="description:en" v="In 2023, the DAMC 05 donated new enamel street signs  to the Nürburgring, in honor of its member Kurt Bosch. Bosch was a long-time clerk of the course and sport director for the ADAC."/>
  <tag k="direction" v="135"/>
  <tag k="historic" v="memorial"/>
  <tag k="image" v="https://upload.wikimedia.org/wikipedia/commons/d/d4/New-street-sign-Kurt-Bosch-Strasse-2023.jpg"/>
