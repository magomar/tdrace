  <tag k="description" v="Durchquert die Eifel, führt über Ahrtal, Hocheifel mit der 'Hohe Acht' (747 m), durchquert über Daun und Manderscheid die zentrale Vulkaneifel mit ihren Maaren, überquert die Kyll kurz vor ihrer Mündung in die Mosel und erreicht Trier als Endpunkt."/>
  <tag k="distance" v="202"/>
  <tag k="fixme" v="Aus Karl-Kaufmann-Weg hervorgegangen. Robert Skiba habt am 04.04. den Verlauf von Brühl bis Hohe Acht kontrolliert und angepasst. Wäre super, wenn den Weg noch jemand von Hohe Acht bis Trier prüfen würde."/>
  <tag k="from" v="Brühl"/>
  <tag k="name" v="Ville-Eifel-Weg"/>
  <tag k="network" v="rwn"/>
  <tag k="old_name:1938-2018" v="Karl-Kaufmann-Weg"/>
  <tag k="old_osmc:symbol" v="black:white:black_pointer:2..:white"/>
  <tag k="old_ref" v="Keil 2"/>
  <tag k="old_symbol" v="schwarzes Dreieck, Spitze nach links und schwarze 2"/>
  <tag k="operator" v="Eifelverein"/>
  <tag k="osmc:symbol" v="black:green:green_rectangle:VEW:black"/>
  <tag k="ref" v="HWW2"/>
  <tag k="roundtrip" v="no"/>
  <tag k="route" v="hiking"/>
  <tag k="symbol" v="3 Balken auf weißem Grund, darunter grüner Balken mit schwarzem Text 'Ville-Eifel-Weg'"/>
