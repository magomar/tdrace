  <tag k="description" v="A prominent hill which forms the backdrop of the Mount Panorama racing circuit overlooking the City of Bathurst."/>
  <tag k="name" v="Mount Panorama"/>
  <tag k="name:wrh" v="Wahluu"/>
  <tag k="name:wrh:meaning" v="Wahluu means young man's initiation place. Wahluu was the name of a young Wiradyuri warrior who was killed by his brother in a fight over a girl."/>
  <tag k="name:wrh:origin" v="Wahluu was the name of a young Wiradyuri warrior who was killed by his older brother Ganhabula in a dispute over a migay (young unmarried woman)."/>
  <tag k="natural" v="peak"/>
  <tag k="ref:nswgnb" v="84264"/>
  <tag k="source" v="nswgnb"/>
 </node>
